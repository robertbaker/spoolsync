{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoolsync.com/schema/cli-report-v1.json",
  "title": "SpoolSync CLI report",
  "description": "Printed to stdout by `spoolsync --format json` (alias `--json`). schemaVersion changes only when a field is removed, renamed, or changes meaning; new optional fields can appear without a new version, so readers should ignore fields they do not know. Warnings and progress go to stderr. Failures print { \"error\": { \"message\": \"...\" } } instead.",
  "oneOf": [{ "$ref": "#/$defs/compareReport" }, { "$ref": "#/$defs/inventoryReport" }],
  "$defs": {
    "sourceId": { "type": "string" },
    "pendingMatch": {
      "type": "object",
      "required": ["pair", "answerWith", "score", "reasons"],
      "properties": {
        "pair": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 2,
          "description": "The two record keys, source:id."
        },
        "answerWith": {
          "type": "string",
          "description": "The value to give --confirm or --reject."
        },
        "score": { "type": "number" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cleanupChange": {
      "type": "object",
      "required": ["spool", "field", "before", "after", "rule", "confidence", "reason", "applicable"],
      "properties": {
        "spool": { "type": "string", "description": "The record key, source:id." },
        "field": { "type": "string" },
        "before": {},
        "after": {},
        "rule": { "type": "string" },
        "confidence": { "enum": ["safe", "review"] },
        "reason": { "type": "string" },
        "applicable": {
          "type": "boolean",
          "description": "Whether the spool's service is writable and stores the field."
        }
      }
    },
    "cleanup": {
      "type": "object",
      "description": "Data cleanup (--cleanup, --cleanup-report). Only safe changes a service can take are added to the plan, and only with --cleanup.",
      "required": ["rules", "counts", "applied", "warnings", "duplicatesAfterCleanup"],
      "properties": {
        "rules": { "type": "array", "items": { "type": "string" } },
        "counts": {
          "type": "object",
          "required": ["proposals", "safe", "review", "applicable", "warnings"],
          "properties": {
            "proposals": { "type": "integer" },
            "safe": { "type": "integer" },
            "review": { "type": "integer" },
            "applicable": { "type": "integer" },
            "warnings": { "type": "integer" }
          }
        },
        "applied": {
          "type": "array",
          "description": "Changes added to the plan; empty without --cleanup.",
          "items": { "$ref": "#/$defs/cleanupChange" }
        },
        "proposals": {
          "type": "array",
          "description": "Every proposal, with --cleanup-report.",
          "items": { "$ref": "#/$defs/cleanupChange" }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["spool", "field", "rule", "message"],
            "properties": {
              "spool": { "type": "string" },
              "field": { "type": "string" },
              "rule": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        },
        "duplicatesAfterCleanup": {
          "type": "array",
          "description": "Groups of record keys that look like duplicates once the applied changes are in place.",
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "referenceChange": {
      "type": "object",
      "required": ["spool", "field", "before", "after", "kind", "confidence", "reference", "reason", "applicable"],
      "properties": {
        "spool": { "type": "string", "description": "The record key, source:id." },
        "field": { "type": "string" },
        "before": {},
        "after": {},
        "kind": { "enum": ["fill", "overwrite"], "description": "fill supplies a missing value; overwrite replaces an existing one and is never added to the plan." },
        "confidence": { "enum": ["safe", "review"] },
        "reference": { "type": "string", "description": "The id of the reference record the value came from." },
        "reason": { "type": "string" },
        "applicable": {
          "type": "boolean",
          "description": "Whether the spool's service is writable and stores the field."
        }
      }
    },
    "reference": {
      "type": "object",
      "description": "Reference data (--reference, --reference-report). Only safe fills from confident, unambiguous matches that a service can take are added to the plan, and only with --reference. The CLI reads the file given and contacts no reference service.",
      "required": ["provider", "file", "attribution", "license", "catalog", "counts", "applied", "warnings"],
      "properties": {
        "provider": { "type": "string" },
        "file": { "type": "string" },
        "attribution": { "type": "string", "description": "The credit line carried by the reference file." },
        "license": { "type": ["string", "null"] },
        "catalog": {
          "type": "object",
          "required": ["records", "usable", "skipped"],
          "properties": {
            "records": { "type": "integer" },
            "usable": { "type": "integer" },
            "skipped": { "type": "integer" }
          }
        },
        "counts": {
          "type": "object",
          "required": ["spools", "matched", "ambiguous", "suggested", "unmatched", "proposals", "safe", "review", "applicable", "colorMismatches", "colorClose"],
          "properties": {
            "spools": { "type": "integer" },
            "matched": { "type": "integer" },
            "ambiguous": { "type": "integer" },
            "suggested": { "type": "integer" },
            "unmatched": { "type": "integer" },
            "proposals": { "type": "integer" },
            "safe": { "type": "integer" },
            "review": { "type": "integer" },
            "applicable": { "type": "integer" },
            "colorMismatches": { "type": "integer" },
            "colorClose": { "type": "integer" }
          }
        },
        "applied": {
          "type": "array",
          "description": "Changes added to the plan; empty without --reference.",
          "items": { "$ref": "#/$defs/referenceChange" }
        },
        "proposals": {
          "type": "array",
          "description": "Every proposal, with --reference-report.",
          "items": { "$ref": "#/$defs/referenceChange" }
        },
        "ambiguous": {
          "type": "array",
          "description": "With --reference-report: spools whose match needs a person's choice. Nothing is chosen for them.",
          "items": {
            "type": "object",
            "required": ["spool", "status", "note", "candidates"],
            "properties": {
              "spool": { "type": "string" },
              "status": { "enum": ["ambiguous", "suggested"] },
              "note": { "type": ["string", "null"] },
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "label", "score", "confidence"],
                  "properties": {
                    "id": { "type": "string" },
                    "label": { "type": "string" },
                    "score": { "type": "number" },
                    "confidence": { "enum": ["high", "medium", "low"] }
                  }
                }
              }
            }
          }
        },
        "colorChecks": {
          "type": "array",
          "description": "With --reference-report: colors that are not a match (CIEDE2000 above 2.3).",
          "items": {
            "type": "object",
            "required": ["spool", "spoolHex", "referenceHex", "deltaE", "verdict", "countDiffers"],
            "properties": {
              "spool": { "type": "string" },
              "spoolHex": { "type": "string" },
              "referenceHex": { "type": "string" },
              "deltaE": { "type": "number" },
              "verdict": { "enum": ["match", "close", "mismatch"] },
              "countDiffers": { "type": "boolean" }
            }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "snapshotSpool": {
      "type": "object",
      "required": ["key", "label", "remainingGrams"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "remainingGrams": { "type": ["number", "null"] }
      }
    },
    "changesSinceLastRun": {
      "type": "object",
      "description": "With --watch, what differs from the previous run. Present only when something changed. Every list is sorted by key.",
      "required": ["added", "removed", "remainingWeight", "newPendingMatches"],
      "properties": {
        "added": { "type": "array", "items": { "$ref": "#/$defs/snapshotSpool" } },
        "removed": { "type": "array", "items": { "$ref": "#/$defs/snapshotSpool" } },
        "remainingWeight": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label", "fromGrams", "toGrams"],
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "fromGrams": { "type": ["number", "null"] },
              "toGrams": { "type": ["number", "null"] }
            }
          }
        },
        "newPendingMatches": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Pending possible matches as key,key that were not pending in the previous run."
        }
      }
    },
    "compareReport": {
      "type": "object",
      "required": [
        "schemaVersion",
        "report",
        "inventories",
        "groups",
        "suggestions",
        "pendingMatches",
        "problems",
        "unresolved",
        "changes",
        "plannedChanges",
        "written",
        "exportWarnings"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "report": { "const": "compare" },
        "inventories": {
          "type": "object",
          "description": "Keyed by source, in source order.",
          "additionalProperties": {
            "type": "object",
            "required": ["spools", "warnings"],
            "properties": {
              "file": { "type": "string" },
              "spools": { "type": "integer" },
              "warnings": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "groups": { "type": "integer" },
        "suggestions": { "type": "array" },
        "pendingMatches": { "type": "array", "items": { "$ref": "#/$defs/pendingMatch" } },
        "problems": { "type": "array", "items": { "type": "string" } },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["group", "field"],
            "properties": { "group": { "type": "string" }, "field": { "type": "string" } }
          }
        },
        "changes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["updates", "creates"],
            "properties": { "updates": { "type": "integer" }, "creates": { "type": "integer" } }
          }
        },
        "plannedChanges": { "type": "object", "additionalProperties": { "type": "array" } },
        "applied": { "type": "array" },
        "written": { "type": "array", "items": { "type": "string" } },
        "csvExport": { "type": "string" },
        "exportWarnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "message"],
            "properties": { "source": { "type": "string" }, "message": { "type": "string" } }
          }
        },
        "cleanup": { "$ref": "#/$defs/cleanup" },
        "reference": { "$ref": "#/$defs/reference" },
        "changesSinceLastRun": { "$ref": "#/$defs/changesSinceLastRun" }
      }
    },
    "inventoryReport": {
      "type": "object",
      "required": ["schemaVersion", "report", "written"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "report": { "const": "inventory" },
        "inventories": {
          "type": "array",
          "description": "With --summary, in source order.",
          "items": {
            "type": "object",
            "required": [
              "source",
              "spools",
              "archived",
              "brands",
              "materials",
              "remainingGrams",
              "unknownWeights",
              "runningLow",
              "warnings"
            ],
            "properties": {
              "source": { "type": "string" },
              "spools": { "type": "integer" },
              "archived": { "type": "integer" },
              "brands": { "type": "integer" },
              "materials": { "type": "integer" },
              "remainingGrams": { "type": "number" },
              "unknownWeights": { "type": "integer" },
              "runningLow": { "type": "integer" },
              "warnings": { "type": "integer" }
            }
          }
        },
        "reorder": {
          "type": "array",
          "description": "With --reorder, emptiest first.",
          "items": {
            "type": "object",
            "required": [
              "service",
              "id",
              "vendor",
              "material",
              "name",
              "remainingGrams",
              "fraction"
            ],
            "properties": {
              "service": { "type": "string" },
              "id": { "type": "string" },
              "vendor": { "type": ["string", "null"] },
              "material": { "type": ["string", "null"] },
              "name": { "type": ["string", "null"] },
              "remainingGrams": { "type": ["number", "null"] },
              "fraction": { "type": ["number", "null"] }
            }
          }
        },
        "spools": { "type": "integer" },
        "cleanup": { "$ref": "#/$defs/cleanup" },
        "reference": { "$ref": "#/$defs/reference" },
        "csvExport": { "type": "string" },
        "written": { "type": "array", "items": { "type": "string" } },
        "changesSinceLastRun": { "$ref": "#/$defs/changesSinceLastRun" }
      }
    }
  }
}
