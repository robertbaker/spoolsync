{
  "name": "spoolsync",
  "version": "0.1.2",
  "description": "CLI for comparing filament inventories across Spoolman, Spoolstock, Spoolio, TigerTag, 3DFilamentProfiles, Bambuddy, and FilaMeter, and syncing updates",
  "homepage": "https://spoolsync.com",
  "bugs": {
    "url": "https://github.com/robertbaker/spoolsync/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/robertbaker/spoolsync.git",
    "directory": "packages/spoolsync-cli"
  },
  "bin": {
    "spoolsync": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outfile=dist/cli.js --external papaparse --external zod",
    "prepack": "bun run test:dist",
    "release": "release-it",
    "test": "bun test ./src/",
    "test:dist": "bun run build && SPOOLSYNC_CLI_PATH=./dist/cli.js bun test ./src/cli.test.ts"
  },
  "dependencies": {
    "papaparse": "^5.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "release-it": "^21.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "release-it": {
    "git": {
      "tagName": "spoolsync-cli-v${version}",
      "tagMatch": "spoolsync-cli-v[0-9]*",
      "commitMessage": "chore(spoolsync-cli): release v${version}",
      "requireCleanWorkingDir": true,
      "assets": [
        "package.json",
        "CHANGELOG.md",
        "../../bun.lock"
      ]
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true,
      "publishArgs": [
        "--access=public"
      ]
    },
    "hooks": {
      "after:bump": "bun install --lockfile-only && bun run build"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits"
        },
        "gitRawCommitsOpts": {
          "path": [
            ".",
            "../spoolsync-core"
          ]
        }
      }
    }
  }
}
