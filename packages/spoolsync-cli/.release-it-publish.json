{
  "increment": false,
  "git": {
    "tagName": "spoolsync-cli-v${version}",
    "tagMatch": "spoolsync-cli-v[0-9]*",
    "commit": false,
    "tag": true,
    "push": true,
    "requireCleanWorkingDir": true
  },
  "github": {
    "release": true,
    "autoGenerate": true
  },
  "npm": {
    "publish": true,
    "skipChecks": true,
    "publishArgs": ["--access=public"]
  }
}
