{
  "name": "spoolsync-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "dev:fast": "ASTRO_TELEMETRY_DISABLED=1 DISABLE_ASTRO_TOOLBAR=true astro dev --host",
    "lint": "oxlint --ignore-path .oxlintignore",
    "test": "bun test --reporter=dots ./src/ ./packages/ ./tools/",
    "test:e2e": "playwright test --reporter=github --grep-invert '.visual'",
    "preview": "wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "astro check",
    "check": "astro check",
    "format": "oxfmt --write src tests tools packages",
    "e2e": "bun run test:e2e",
    "ci": "bun run check:packages && bun run check && bun run lint && bun run test && bun run test:cli && bun run e2e",
    "spoolman:import": "bun run tools/tigertag/spoolman-to-ttag.ts",
    "generate:social": "bun run tools/generate-social-card.ts",
    "spoolsync:sync": "bun run packages/spoolsync-cli/src/cli.ts",
    "spoolsync:release": "bun run --filter spoolsync release",
    "release": "bun run spoolsync:release",
    "check:packages": "tsc --project packages/tsconfig.json",
    "test:cli": "bun run --filter spoolsync test:dist"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@iconify-json/material-symbols": "^1.2.96",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify-json/tabler": "^1.2.42",
    "@spoolsync/core": "workspace:*",
    "astro": "^7.4.2",
    "astro-icon": "^1.2.0",
    "papaparse": "^5.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@happy-dom/global-registrator": "^21.0.4",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "browserslist": "^4.29.5",
    "bun-types": "^1.4.4",
    "happy-dom": "^21.0.4",
    "lefthook": "^2.2.2",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tailwindcss-intersect": "^3.0.0",
    "tailwindcss-motion": "^1.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "bun": ">=1.2"
  }
}
