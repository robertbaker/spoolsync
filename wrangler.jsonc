{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page"
  },
  "account_id": "1e577dc124a5e5df1751c0aca5a4e856",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
    "inspector_port": 9234,
    "port": 4324
  },
  "minify": true,
  "name": "spoolsync",
  "preview_urls": false,
  "routes": [
    {
      "custom_domain": true,
      "pattern": "www.spoolsync.com"
    },
    {
      "pattern": "www.spoolsync.com/*",
      "zone_name": "spoolsync.com"
    }
  ],
  "workers_dev": false
}
