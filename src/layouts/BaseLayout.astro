---
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import cliPackage from "../../packages/spoolsync-cli/package.json";
import SiteBaseLayout from "~/components/starwind/layouts/SiteBaseLayout.astro";
import {
  SITE_URL,
  TWITTER_HANDLE,
  SITE_DESCRIPTION,
  SITE_CONFIG,
  SITE_BRAND_NAME,
  SOCIAL_LINKS,
  navLinks,
} from "~/config";
import {
  DEFAULT_SOCIAL_IMAGE,
  DEFAULT_SOCIAL_IMAGE_ALT,
  NOINDEX_ROBOTS,
  normalizeSeoPath,
  shouldNoindexPath,
} from "~/config/seo";
import { allServiceNames } from "~/lib/services";
import globalStylesheetHref from "~/styles/global.css?url";

interface Props {
  title: string;
  description?: string;
  post?: CollectionEntry<"blog">;
  image?: ImageMetadata | string;
  imageAlt?: string;
  robots?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const { title, description, post, image, imageAlt, robots, hideHeader, hideFooter } = Astro.props;
// Desktop shows these as header/footer links; on mobile they live in the bottom nav's "More" menu.
const mobileNavLinks = [
  ...navLinks,
  {
    href: "https://github.com/robertbaker/spoolsync",
    label: "GitHub",
    text: "GitHub",
    icon: "simple-icons:github",
    external: true,
  },
  {
    href: "https://github.com/robertbaker/spoolsync/issues/new",
    label: "Report an issue",
    text: "Report an issue",
    icon: "material-symbols:bug-report-outline",
    external: true,
  },
  {
    href: "https://ko-fi.com/spool_sync",
    label: "Support on Ko-fi",
    text: "Support on Ko-fi",
    icon: "simple-icons:kofi",
    external: true,
  },
  {
    href: "/credits",
    label: "Credits",
    text: "Credits",
    icon: "material-symbols:attribution-outline",
  },
];
const normalizedPath =normalizeSeoPath(Astro.url.pathname);
const resolvedRobots = robots ?? (shouldNoindexPath(normalizedPath) ? NOINDEX_ROBOTS : undefined);
---

<SiteBaseLayout
  title={title}
  {...(description ? { description } : {})}
  {...(post ? { post } : {})}
  siteTitle={SITE_BRAND_NAME}
  siteDescription={SITE_DESCRIPTION}
  siteUrl={SITE_URL}
  image={image ?? DEFAULT_SOCIAL_IMAGE}
  imageAlt={imageAlt ?? DEFAULT_SOCIAL_IMAGE_ALT}
  appleTouchIconHref="/icons/apple-touch-icon.png"
  twitterHandle={TWITTER_HANDLE}
  socialLinks={SOCIAL_LINKS}
  navLinks={navLinks}
  mobileNavLinks={mobileNavLinks}
  config={SITE_CONFIG}
  {...(resolvedRobots ? { robots: resolvedRobots } : {})}
  {...(hideHeader ? { hideHeader } : {})}
  {...(hideFooter ? { hideFooter } : {})}
  scrollSmooth
  mainId="main-content"
  mainClass="pb-24 lg:pb-8 flex-1 min-w-0"
  skipLinkClass="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-100 focus-visible:rounded-lg focus-visible:bg-card focus-visible:px-4 focus-visible:py-2.5 focus-visible:text-sm focus-visible:font-semibold focus-visible:text-foreground focus-visible:border focus-visible:border-primary focus-visible:shadow-layered focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
>
  <span slot="header-logo" class="group flex items-center gap-2 text-xl font-extrabold tracking-tight text-foreground">
    <img src="/logo-mark.svg" alt="" class="size-9 transition-transform duration-300 group-hover:scale-105 group-hover:rotate-6" width="36" height="36" />
    <span>Spool<span class="text-primary-text">Sync</span></span>
  </span>
  <Fragment slot="header-actions">
    <button
      type="button"
      data-install-app
      hidden
      data-print="hide"
      class="inline-flex h-9 items-center gap-1.5 rounded-full border px-3 text-xs font-medium text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      title="Install SpoolSync as an app"
    >
      <Icon name="material-symbols:download-rounded" class="size-4" aria-hidden="true" />
      Install
    </button>
    <a
      href="https://github.com/robertbaker/spoolsync"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex size-9 items-center justify-center rounded-full text-foreground transition-all hover:scale-105 hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      aria-label="SpoolSync on GitHub"
      title="SpoolSync on GitHub"
    >
      <Icon name="simple-icons:github" class="size-5" aria-hidden="true" />
    </a>
    <a
      href="https://ko-fi.com/spool_sync"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex size-9 items-center justify-center rounded-full bg-[#ff5e5b] text-white transition-all hover:scale-105 hover:bg-[#e94d4a] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      aria-label="Support SpoolSync on Ko-fi"
      title="Support SpoolSync on Ko-fi"
    >
      <Icon name="simple-icons:kofi" class="size-5" aria-hidden="true" />
    </a>
  </Fragment>
  <span slot="footer-logo" class="flex items-center gap-2 text-2xl font-extrabold tracking-tight text-foreground">
    <img src="/logo-mark.svg" alt="" class="size-10" width="40" height="40" loading="lazy" />
    <span>Spool<span class="text-primary-text">Sync</span></span>
  </span>
  <Fragment slot="copyright-content">
    <a class="footer-link underline" href="https://robertbaker.dev">Robert Baker</a>
    <span> and the </span>
    <a class="footer-link underline" href="https://github.com/robertbaker/spoolsync">contributors of SpoolSync</a>
    <span> · Open source under </span>
    <a class="footer-link underline" href="https://github.com/robertbaker/spoolsync/blob/main/LICENSE">AGPL-3.0</a>
    <span> · </span>
    <a class="footer-link underline" href="https://ko-fi.com/spool_sync" target="_blank" rel="noopener noreferrer">
      Support us on Ko-fi
    </a>
    <span> · </span>
    <a
      class="footer-link underline"
      href="https://github.com/robertbaker/spoolsync/issues/new"
      target="_blank"
      rel="noopener noreferrer"
    >
      Report an issue / bug
    </a>
    <span> · </span>
    <a class="footer-link underline" href="/credits">
      Credits
    </a>
    <span> · </span>
    <button type="button" class="footer-link underline" data-open-shortcuts>Keyboard shortcuts</button>
    <span> · </span>
    <button type="button" class="footer-link underline" data-open-changelog data-version={cliPackage.version} aria-label={`SpoolSync version ${cliPackage.version}, show what is new`}>v{cliPackage.version}</button>
    <span> · </span>
    <button type="button" class="footer-link underline" data-open-saved-data>Saved settings</button>
    <span> · </span>
    <button type="button" class="footer-link underline" data-open-palette aria-keyshortcuts="Control+K Meta+K">Command palette</button>
    <span> · </span>
    <button type="button" class="footer-link underline" data-open-setup>Setup guide</button>
    <span class="mt-2 block text-xs opacity-80">
      SpoolSync is independent and not affiliated with or endorsed by {allServiceNames(undefined, "or", ["Bambu Lab"])}. All names and logos are trademarks of their respective owners and are used only to identify compatibility.
    </span>
  </Fragment>
  <Fragment slot="head">
    <meta name="color-scheme" content="light dark" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/fonts/inter-latin-variable-wghtOnly-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={globalStylesheetHref} />
    <slot name="head" />
  </Fragment>
  <slot />
</SiteBaseLayout>

<script>
  import "~/scripts/tour";
  import "~/scripts/pwa";
  import { announceUpdate, wireChangelog } from "~/scripts/changelog-dialog";
  import { wireSavedData } from "~/scripts/saved-data-dialog";
  import { wireShortcutsHelp } from "~/scripts/shortcuts-help";
  import { wirePalette } from "~/scripts/palette";
  import { wireSetupTriggers } from "~/scripts/setup/launch";

  wireShortcutsHelp();
  wirePalette();
  wireSetupTriggers();
  wireSavedData();
  wireChangelog();
  announceUpdate(document.querySelector<HTMLElement>("[data-open-changelog]")?.dataset["version"] ?? "");

  // Modern Web Guidance: Sync aria-invalid with CSS :user-invalid state
  const syncAria = (el: Element | null) => {
    if (el && "matches" in el && typeof el.matches === "function") {
      if (el.matches("input, textarea, select")) {
        el.setAttribute("aria-invalid", el.matches(":user-invalid") ? "true" : "false");
      }
    }
  };
  document.addEventListener("blur", (e) => syncAria(e.target as Element), true);
  document.addEventListener("input", (e) => {
    const target = e.target as Element;
    if (target?.hasAttribute("aria-invalid")) syncAria(target);
  });
</script>
