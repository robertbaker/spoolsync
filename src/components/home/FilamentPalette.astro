---
/**
 * Interactive Filament & Material Spec Rack.
 * Displays a tactile rack of 3D printing filaments with realistic spool visuals,
 * live spec cards, and SpoolSync cross-platform normalization details.
 */
import { Icon } from "astro-icon/components";

const filaments = [
  {
    id: "galaxy-black",
    name: "PolyLite Galaxy Black",
    brand: "Polymaker",
    material: "PLA",
    colorHex: "#1e1e24",
    accentBorder: "border-zinc-500",
    glowColor: "rgba(30, 30, 36, 0.4)",
    nozzleTemp: "190–220 °C",
    bedTemp: "50–60 °C",
    density: "1.24 g/cm³",
    remainingWeight: "740 g",
    totalWeight: "1,000 g",
    percent: 74,
    notes: "Easy printing, zero enclosure required, fine cosmetic glitter finish.",
    unifiedId: "POL-PLA-GLX-001",
    tagUid: "E2:80:68:10:44",
  },
  {
    id: "cyan-petg",
    name: "Translucent Cyan",
    brand: "Bambu Lab",
    material: "PETG",
    colorHex: "#06b6d4",
    accentBorder: "border-cyan-500",
    glowColor: "rgba(6, 182, 212, 0.35)",
    nozzleTemp: "230–250 °C",
    bedTemp: "70–80 °C",
    density: "1.27 g/cm³",
    remainingWeight: "420 g",
    totalWeight: "1,000 g",
    percent: 42,
    notes: "High impact resistance, chemical safe, waterproof layer bonding.",
    unifiedId: "BMB-PETG-CYN-108",
    tagUid: "04:A2:3B:1C:88",
  },
  {
    id: "prusa-orange",
    name: "Prusa Orange",
    brand: "Prusament",
    material: "ASA",
    colorHex: "#f97316",
    accentBorder: "border-orange-500",
    glowColor: "rgba(249, 115, 22, 0.35)",
    nozzleTemp: "240–260 °C",
    bedTemp: "90–110 °C",
    density: "1.07 g/cm³",
    remainingWeight: "980 g",
    totalWeight: "1,000 g",
    percent: 98,
    notes: "UV & weather resistant outdoor filament; enclosed chamber recommended.",
    unifiedId: "PRU-ASA-ORG-042",
    tagUid: "D4:11:09:AC:23",
  },
  {
    id: "signal-red",
    name: "Signal Red 95A",
    brand: "Fiberlogy",
    material: "TPU",
    colorHex: "#e11d48",
    accentBorder: "border-rose-500",
    glowColor: "rgba(225, 29, 72, 0.35)",
    nozzleTemp: "210–230 °C",
    bedTemp: "40–50 °C",
    density: "1.21 g/cm³",
    remainingWeight: "650 g",
    totalWeight: "850 g",
    percent: 76,
    notes: "Elastic shore 95A hardness, high flexural fatigue resistance.",
    unifiedId: "FIB-TPU-RED-95A",
    tagUid: "B8:60:FE:91:02",
  },
  {
    id: "stealth-carbon",
    name: "PolyMide PA6-CF",
    brand: "Polymaker",
    material: "PA-CF",
    colorHex: "#475569",
    accentBorder: "border-slate-500",
    glowColor: "rgba(71, 85, 105, 0.35)",
    nozzleTemp: "280–300 °C",
    bedTemp: "80–100 °C",
    density: "1.15 g/cm³",
    remainingWeight: "890 g",
    totalWeight: "1,000 g",
    percent: 89,
    notes: "20% chopped carbon fiber reinforced nylon; hardened steel nozzle required.",
    unifiedId: "POL-PACF-STL-890",
    tagUid: "AA:4F:19:62:30",
  },
];
---

<section class="mt-20 scroll-mt-20" id="filament-palette-section">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-primary-text">Universal Filament Schema</p>
      <h2 class="mt-1 text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
        Built for every spool on your rack
      </h2>
      <p class="mt-2 max-w-2xl text-muted-foreground text-sm sm:text-base">
        Select a filament spool below to see how SpoolSync captures color codes, remaining weights, and material properties without vendor lock-in.
      </p>
    </div>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]" id="filament-rack">
    <!-- Spool Selector Rack -->
    <div class="glass-surface rounded-3xl border border-border/80 p-5 sm:p-6 shadow-layered">
      <div class="flex items-center justify-between border-b border-border/70 pb-3 text-xs">
        <span class="font-bold text-foreground flex items-center gap-1.5">
          <Icon name="material-symbols:shelves" class="size-4 text-primary-text" />
          Interactive Spool Rack
        </span>
        <span class="text-muted-foreground">Click a spool to inspect</span>
      </div>

      <div
        role="tablist"
        aria-label="Filament spool selection"
        class="mt-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3"
      >
        {filaments.map((f, index) => (
          <button
            type="button"
            role="tab"
            id={`tab-spool-${f.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`panel-spool-${f.id}`}
            tabindex={index === 0 ? 0 : -1}
            data-spool-id={f.id}
            class:list={[
              "spool-rack-btn group relative flex flex-col justify-between rounded-2xl border p-4 text-left transition-all duration-300 hover:-translate-y-1 hover:shadow-md",
              index === 0
                ? "border-primary bg-primary/10 shadow-xs ring-2 ring-primary/30"
                : "border-border/70 bg-card/60 hover:border-primary/40 hover:bg-card",
            ]}
          >
            <!-- 3D Spool Graphic -->
            <div class="flex items-center justify-between gap-3">
              <div class="relative flex size-12 shrink-0 items-center justify-center">
                <!-- Outer spool rim -->
                <div
                  class="size-12 rounded-full border-2 border-border/80 shadow-md flex items-center justify-center filament-swatch"
                  style={`background: radial-gradient(circle at 35% 35%, ${f.colorHex}, #000 95%);`}
                >
                  <!-- Spool inner hub hole -->
                  <div class="size-4 rounded-full bg-background/90 shadow-inner ring-1 ring-black/30 dark:ring-white/20"></div>
                </div>
              </div>

              <!-- Material Pill -->
              <span class="rounded-md bg-background/80 px-2 py-0.5 text-[0.7rem] font-black uppercase text-foreground border border-border/60">
                {f.material}
              </span>
            </div>

            <div class="mt-3 min-w-0">
              <h3 class="truncate text-sm font-bold text-foreground leading-tight group-hover:text-primary-text transition-colors">
                {f.name}
              </h3>
              <p class="text-xs text-muted-foreground">{f.brand}</p>
            </div>

            <!-- Remaining Gauge -->
            <div class="mt-3 border-t border-border/50 pt-2">
              <div class="flex justify-between text-[0.68rem] text-muted-foreground font-medium">
                <span>{f.remainingWeight}</span>
                <span>{f.percent}%</span>
              </div>
              <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div
                  class="h-full rounded-full transition-all duration-500"
                  style={`width: ${f.percent}%; background-color: ${f.colorHex};`}
                ></div>
              </div>
            </div>
          </button>
        ))}
      </div>
    </div>

    <!-- Active Spool Inspection Inspector Panel -->
    <div class="glass-surface relative overflow-hidden rounded-3xl border border-primary/25 bg-card/95 p-6 shadow-layered flex flex-col justify-between">
      <div class="pointer-events-none absolute -right-16 -top-16 size-48 rounded-full bg-primary/10 blur-2xl" aria-hidden="true"></div>

      {filaments.map((f, index) => (
        <div
          role="tabpanel"
          id={`panel-spool-${f.id}`}
          aria-labelledby={`tab-spool-${f.id}`}
          class:list={["spool-detail-panel h-full flex flex-col justify-between space-y-5", index !== 0 && "hidden"]}
        >
          <div>
            <div class="flex items-start justify-between gap-3 border-b border-border/70 pb-4">
              <div>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/15 px-2.5 py-0.5 text-xs font-semibold text-primary-text">
                  <Icon name="material-symbols:barcode-scanner" class="size-3.5" />
                  {f.unifiedId}
                </span>
                <h3 class="mt-2 text-2xl font-black text-foreground">{f.name}</h3>
                <p class="text-sm text-muted-foreground">{f.brand} · {f.material} 1.75mm</p>
              </div>

              <!-- Color Hex Preview Badge -->
              <div class="flex flex-col items-end gap-1">
                <div class="flex items-center gap-2 rounded-xl border border-border bg-background px-2.5 py-1 text-xs font-mono font-bold text-foreground">
                  <span class="size-3.5 rounded-full filament-swatch" style={`background-color: ${f.colorHex};`}></span>
                  <span>{f.colorHex}</span>
                </div>
                <span class="text-[0.68rem] text-muted-foreground font-mono">NFC: {f.tagUid}</span>
              </div>
            </div>

            <!-- Material Thermal & Physical Specs Grid -->
            <div class="mt-4 grid grid-cols-2 gap-2.5 text-xs">
              <div class="rounded-xl border border-border/70 bg-background/60 p-3">
                <span class="text-muted-foreground text-[0.7rem] block">Nozzle Printing Temp</span>
                <span class="font-bold text-foreground text-sm mt-0.5 block">{f.nozzleTemp}</span>
              </div>
              <div class="rounded-xl border border-border/70 bg-background/60 p-3">
                <span class="text-muted-foreground text-[0.7rem] block">Heated Bed Temp</span>
                <span class="font-bold text-foreground text-sm mt-0.5 block">{f.bedTemp}</span>
              </div>
              <div class="rounded-xl border border-border/70 bg-background/60 p-3">
                <span class="text-muted-foreground text-[0.7rem] block">Material Density</span>
                <span class="font-bold text-foreground text-sm mt-0.5 block">{f.density}</span>
              </div>
              <div class="rounded-xl border border-border/70 bg-background/60 p-3">
                <span class="text-muted-foreground text-[0.7rem] block">Spool Capacity</span>
                <span class="font-bold text-foreground text-sm mt-0.5 block">{f.remainingWeight} / {f.totalWeight}</span>
              </div>
            </div>

            <!-- Notes -->
            <p class="mt-4 rounded-xl border border-primary/20 bg-primary/5 p-3 text-xs text-foreground/90 leading-relaxed">
              <strong class="text-primary-text font-bold">Material Profile:</strong> {f.notes}
            </p>
          </div>

          <!-- Bottom Cross-Platform Compatibility Bar -->
          <div class="rounded-xl border border-border/60 bg-muted/40 p-3 text-xs">
            <span class="text-[0.7rem] font-bold text-muted-foreground uppercase tracking-wider block mb-1.5">Cross-System Compatibility</span>
            <div class="flex flex-wrap gap-1.5">
              <span class="rounded bg-background px-2 py-0.5 font-medium text-foreground text-[0.68rem] border border-border/50">Spoolman API</span>
              <span class="rounded bg-background px-2 py-0.5 font-medium text-foreground text-[0.68rem] border border-border/50">Bambu Studio AMS</span>
              <span class="rounded bg-background px-2 py-0.5 font-medium text-foreground text-[0.68rem] border border-border/50">Klipper / Moonraker</span>
              <span class="rounded bg-background px-2 py-0.5 font-medium text-foreground text-[0.68rem] border border-border/50">TigerTag NFC</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initFilamentRack() {
    const rack = document.getElementById("filament-rack");
    if (!rack) return;

    const tabs = rack.querySelectorAll<HTMLButtonElement>(".spool-rack-btn");
    const panels = rack.querySelectorAll<HTMLElement>(".spool-detail-panel");

    function selectSpool(spoolId: string) {
      tabs.forEach((tab) => {
        const isMatch = tab.dataset.spoolId === spoolId;
        tab.setAttribute("aria-selected", isMatch ? "true" : "false");
        tab.setAttribute("tabindex", isMatch ? "0" : "-1");

        if (isMatch) {
          tab.className = "spool-rack-btn group relative flex flex-col justify-between rounded-2xl border p-4 text-left transition-all duration-300 hover:-translate-y-1 hover:shadow-md border-primary bg-primary/10 shadow-xs ring-2 ring-primary/30";
        } else {
          tab.className = "spool-rack-btn group relative flex flex-col justify-between rounded-2xl border p-4 text-left transition-all duration-300 hover:-translate-y-1 hover:shadow-md border-border/70 bg-card/60 hover:border-primary/40 hover:bg-card";
        }
      });

      panels.forEach((panel) => {
        const isMatch = panel.id === `panel-spool-${spoolId}`;
        if (isMatch) {
          panel.classList.remove("hidden");
        } else {
          panel.classList.add("hidden");
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const id = tab.dataset.spoolId;
        if (id) selectSpool(id);
      });

      tab.addEventListener("keydown", (e) => {
        const tabList = Array.from(tabs);
        const index = tabList.indexOf(tab);
        let nextIndex: number | null = null;

        if (e.key === "ArrowRight" || e.key === "ArrowDown") {
          nextIndex = (index + 1) % tabList.length;
        } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
          nextIndex = (index - 1 + tabList.length) % tabList.length;
        }

        if (nextIndex !== null) {
          e.preventDefault();
          const target = tabList[nextIndex];
          target?.focus();
          const id = target?.dataset.spoolId;
          if (id) selectSpool(id);
        }
      });
    });
  }

  initFilamentRack();
  document.addEventListener("astro:page-load", initFilamentRack);
</script>
