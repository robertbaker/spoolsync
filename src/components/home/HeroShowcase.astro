---
/**
 * Interactive-feeling live engine preview showcase for the hero section.
 * Visualizes how SpoolSync reconciles spools across multiple services in real time.
 */
import { Icon } from "astro-icon/components";
import ServiceMark from "~/components/ServiceMark.astro";

const demoSpools = [
  {
    brand: "Polymaker",
    name: "PolyLite Galaxy Black",
    material: "PLA",
    colorHex: "#1e1e24",
    weight: "850g",
    totalWeight: "1000g",
    percent: 85,
    sourceA: "spoolman" as const,
    sourceB: "bambuddy" as const,
    status: "Synced",
    statusColor: "emerald",
  },
  {
    brand: "Bambu Lab",
    name: "Translucent Cyan",
    material: "PETG",
    colorHex: "#06b6d4",
    weight: "420g",
    totalWeight: "1000g",
    percent: 42,
    sourceA: "spoolman" as const,
    sourceB: "tigertag" as const,
    status: "1 diff resolved",
    statusColor: "amber",
  },
  {
    brand: "Prusament",
    name: "Prusa Orange",
    material: "ASA",
    colorHex: "#f97316",
    weight: "980g",
    totalWeight: "1000g",
    percent: 98,
    sourceA: "filameter" as const,
    sourceB: "spoolman" as const,
    status: "Matched",
    statusColor: "emerald",
  },
];
---

<div class="glass-surface relative overflow-hidden rounded-2xl p-5 shadow-layered sm:p-6 transition-all duration-300 hover:shadow-xl" aria-hidden="true">
  <!-- Subtle ambient glow inside the card -->
  <div class="pointer-events-none absolute -right-16 -top-16 size-48 rounded-full bg-primary/10 blur-2xl" aria-hidden="true"></div>

  <!-- Simulated window header -->
  <div class="flex items-center justify-between border-b pb-3.5 text-xs">
    <div class="flex items-center gap-1.5">
      <span class="size-2.5 rounded-full bg-red-400/80"></span>
      <span class="size-2.5 rounded-full bg-amber-400/80"></span>
      <span class="size-2.5 rounded-full bg-emerald-400/80"></span>
      <span class="ml-2 font-mono text-[0.7rem] font-medium text-muted-foreground">spoolsync-engine</span>
    </div>
    <div class="inline-flex items-center gap-1.5 rounded-full bg-success/15 px-2.5 py-0.5 font-medium text-success text-[0.7rem]">
      <span class="relative flex size-1.5">
        <span class="absolute inline-flex h-full w-full motion-safe:animate-ping rounded-full bg-success opacity-75"></span>
        <span class="relative inline-flex size-1.5 rounded-full bg-success"></span>
      </span>
      Live Browser Sync
    </div>
  </div>

  <!-- Connected pipeline overview -->
  <div class="mt-4 flex items-center justify-between rounded-xl bg-background/70 px-3.5 py-2.5 text-xs font-medium border border-border/60">
    <span class="text-muted-foreground">Sync Sources:</span>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1 rounded-md bg-muted/80 px-2 py-0.5 text-foreground">
        <ServiceMark id="spoolman" class="size-3.5" /> Spoolman
      </span>
      <Icon name="material-symbols:sync-alt" class="size-3.5 text-primary-text" />
      <span class="inline-flex items-center gap-1 rounded-md bg-muted/80 px-2 py-0.5 text-foreground">
        <ServiceMark id="bambuddy" class="size-3.5" /> Bambuddy
      </span>
      <span class="inline-flex items-center gap-1 rounded-md bg-muted/80 px-2 py-0.5 text-foreground">
        <ServiceMark id="tigertag" class="size-3.5" /> TigerTag
      </span>
    </div>
  </div>

  <!-- Reconciled spools list -->
  <div class="mt-4 space-y-2.5">
    {demoSpools.map((spool) => (
      <div class="group relative rounded-xl border border-border/60 bg-card/90 p-3 transition-colors hover:border-primary/40 hover:bg-card">
        <div class="flex items-start justify-between gap-2">
          <div class="flex items-center gap-2.5 min-w-0">
            <!-- Filament Color Swatch with 3D Ring Effect -->
            <span
              class="filament-swatch size-7 shrink-0 ring-1 ring-black/10 dark:ring-white/10"
              style={`background-color: ${spool.colorHex};`}
            />
            <div class="min-w-0">
              <div class="flex items-center gap-1.5">
                <span class="truncate font-semibold text-sm leading-tight text-foreground">{spool.name}</span>
                <span class="shrink-0 rounded bg-muted px-1.5 py-0.2 text-[0.65rem] font-bold uppercase text-muted-foreground">
                  {spool.material}
                </span>
              </div>
              <p class="text-xs text-muted-foreground">{spool.brand} · 1.75mm</p>
            </div>
          </div>

          <!-- Status badge -->
          <div class="shrink-0">
            {spool.statusColor === "emerald" ? (
              <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/15 px-2 py-0.5 text-[0.68rem] font-semibold text-emerald-800 dark:text-emerald-300 border border-emerald-500/30">
                <Icon name="material-symbols:check-circle-rounded" class="size-3" />
                {spool.status}
              </span>
            ) : (
              <span class="inline-flex items-center gap-1 rounded-full bg-amber-500/15 px-2 py-0.5 text-[0.68rem] font-semibold text-amber-800 dark:text-amber-300 border border-amber-500/30">
                <Icon name="material-symbols:auto-fix-high" class="size-3" />
                {spool.status}
              </span>
            )}
          </div>
        </div>

        <!-- Filament Remaining Bar -->
        <div class="mt-2.5">
          <div class="flex items-center justify-between text-[0.7rem] text-muted-foreground font-mono">
            <span>Remaining</span>
            <span class="font-medium text-foreground">{spool.weight} / {spool.totalWeight}</span>
          </div>
          <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-muted">
            <div
              class="h-full rounded-full bg-gradient-to-r from-primary to-amber-500 transition-all duration-500"
              style={`width: ${spool.percent}%;`}
            />
          </div>
        </div>

        <!-- Linked services foot -->
        <div class="mt-2 flex items-center justify-between text-[0.7rem] text-muted-foreground border-t border-border/40 pt-1.5">
          <div class="flex items-center gap-1.5">
            <ServiceMark id={spool.sourceA} class="size-3" />
            <span>Linked</span>
            <ServiceMark id={spool.sourceB} class="size-3" />
          </div>
          <span class="text-[0.65rem] text-primary-text font-medium">Auto-matched by ID</span>
        </div>
      </div>
    ))}
  </div>

  <!-- Engine footer banner -->
  <div class="mt-4 flex items-center gap-3 rounded-xl border border-primary/25 bg-primary/10 p-3.5">
    <img src="/logo-mark.svg" alt="" class="size-9 shrink-0" width="36" height="36" />
    <div class="min-w-0 flex-1">
      <p class="text-sm font-extrabold leading-tight text-foreground">
        Spool<span class="text-primary-text">Sync</span> Core
      </p>
      <p class="text-[0.72rem] text-muted-foreground truncate">
        Deterministic ID matching & field resolution · 100% in-browser
      </p>
    </div>
    <Icon name="material-symbols:lock-outline" class="size-4 shrink-0 text-primary-text" />
  </div>
</div>
