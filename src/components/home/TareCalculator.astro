---
/**
 * Interactive Tare & Weigh-In Calculator.
 * Demonstrates SpoolSync's built-in spool tare subtraction and weight estimation
 * right on the homepage, tailored specifically to 3D printing workflows.
 */
import { Icon } from "astro-icon/components";
import { KNOWN_TARES } from "~/lib/weigh-in";
---

<section class="mt-20 scroll-mt-20" id="tare-calculator-section">
  <div class="glass-surface relative overflow-hidden rounded-3xl border border-primary/25 bg-card/95 p-6 sm:p-10 shadow-layered">
    <!-- Ambient glow behind calculator -->
    <div class="pointer-events-none absolute -left-20 -top-20 size-64 rounded-full bg-primary/10 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-20 -right-20 size-64 rounded-full bg-amber-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative z-10 grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center">
      <div>
        <div class="inline-flex items-center gap-1.5 rounded-full bg-primary/15 px-3 py-0.5 text-xs font-semibold text-primary-text mb-3">
          <Icon name="material-symbols:scale" class="size-4" />
          Scale to Sync Engine
        </div>
        <h2 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
          Scale weigh-in, <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-primary via-amber-500 to-orange-400 bg-clip-text text-transparent">
            instantly solved
          </span>
        </h2>
        <p class="mt-3 text-muted-foreground text-sm sm:text-base leading-relaxed">
          Put a partially used spool on your kitchen scale. SpoolSync automatically subtracts the empty spool tare for your brand, calculates the net filament, and writes the verified weight into Spoolman or your exports.
        </p>

        <!-- Brand Tare Selection Buttons -->
        <div class="mt-6">
          <label class="block text-xs font-bold uppercase tracking-wider text-foreground mb-2">
            1. Select Spool Brand (Tare Weight)
          </label>
          <div class="flex flex-wrap gap-2" id="tare-brands" role="radiogroup" aria-label="Spool brand tare">
            {KNOWN_TARES.slice(0, 6).map((tare, index) => (
              <button
                type="button"
                role="radio"
                aria-checked={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
                data-brand={tare.brand}
                data-tare={tare.grams}
                class:list={[
                  "tare-brand-btn rounded-xl border px-3 py-1.5 text-xs font-semibold transition-all duration-200",
                  index === 0
                    ? "border-primary bg-primary/15 text-primary-text ring-1 ring-primary/40 shadow-xs"
                    : "border-border bg-background text-foreground hover:border-primary/40",
                ]}
              >
                <span>{tare.brand}</span>
                <span class="ml-1 text-[0.68rem] font-mono font-medium text-foreground dark:text-foreground">({tare.grams}g)</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Scale Slider / Input -->
        <div class="mt-6 rounded-2xl border border-border/80 bg-background/80 p-4">
          <div class="flex items-center justify-between text-xs font-bold">
            <label for="scale-weight-range" class="text-foreground flex items-center gap-1.5">
              <Icon name="material-symbols:monitor-weight-outline" class="size-4 text-primary-text" />
              2. Scale Reading (Gross Weight)
            </label>
            <span class="font-mono text-base font-extrabold text-foreground" id="gross-display">740 g</span>
          </div>

          <input
            id="scale-weight-range"
            type="range"
            min="260"
            max="1250"
            step="10"
            value="740"
            aria-label="Scale weight reading"
            class="mt-3 w-full accent-primary cursor-pointer h-2 bg-muted rounded-lg"
          />

          <div class="mt-2 flex justify-between text-[0.68rem] text-muted-foreground font-mono">
            <span>260 g (Nearly empty)</span>
            <span>750 g (Half spool)</span>
            <span>1,250 g (Full 1kg spool)</span>
          </div>
        </div>
      </div>

      <!-- Live Calculation Card -->
      <div class="rounded-3xl border border-primary/30 bg-background/90 p-6 sm:p-8 shadow-layered flex flex-col justify-between">
        <div class="border-b border-border/80 pb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground block">Real-Time Analysis</span>
          <div class="mt-2 flex items-baseline justify-between">
            <span class="text-4xl sm:text-5xl font-black text-foreground" id="net-filament">490</span>
            <span class="text-sm font-bold text-muted-foreground">grams of filament left</span>
          </div>

          <!-- Progress Bar Gauge -->
          <div class="mt-4">
            <div class="flex justify-between text-xs font-semibold text-muted-foreground mb-1">
              <span>Spool Capacity</span>
              <span id="capacity-percent">49%</span>
            </div>
            <div class="h-2.5 w-full overflow-hidden rounded-full bg-muted">
              <div
                id="gauge-bar"
                class="h-full rounded-full bg-gradient-to-r from-primary to-amber-500 transition-all duration-300"
                style="width: 49%;"
              ></div>
            </div>
          </div>
        </div>

        <!-- 3D Print Estimations Grid -->
        <div class="mt-6 grid grid-cols-2 gap-3 text-xs">
          <div class="rounded-2xl border border-border/70 bg-card/60 p-3.5">
            <span class="text-muted-foreground text-[0.7rem] block">Estimated Filament Length</span>
            <span class="font-bold text-foreground text-base mt-0.5 block font-mono" id="length-estimate">~164 m</span>
            <span class="text-[0.65rem] text-muted-foreground">1.75mm PLA standard</span>
          </div>

          <div class="rounded-2xl border border-border/70 bg-card/60 p-3.5">
            <span class="text-muted-foreground text-[0.7rem] block">Prints Remaining</span>
            <span class="font-bold text-foreground text-base mt-0.5 block font-mono" id="benchy-estimate">~38 Benchies</span>
            <span class="text-[0.65rem] text-muted-foreground">~13g per standard model</span>
          </div>
        </div>

        <!-- Tare math summary badge -->
        <div class="mt-6 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3 text-xs flex items-center justify-between text-emerald-800 dark:text-emerald-300 font-semibold">
          <span class="flex items-center gap-1.5">
            <Icon name="material-symbols:check-circle-rounded" class="size-4 shrink-0" />
            <span id="formula-text">740g gross - 250g (Bambu Lab tare) = 490g net</span>
          </span>
          <span class="rounded bg-emerald-500/20 px-2 py-0.5 text-[0.68rem] font-bold uppercase">Ready</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initTareCalculator() {
    const root = document.getElementById("tare-calculator-section");
    if (!root) return;

    const brandButtons = root.querySelectorAll<HTMLButtonElement>(".tare-brand-btn");
    const slider = root.querySelector<HTMLInputElement>("#scale-weight-range");
    const grossDisplay = root.querySelector<HTMLElement>("#gross-display");
    const netDisplay = root.querySelector<HTMLElement>("#net-filament");
    const percentDisplay = root.querySelector<HTMLElement>("#capacity-percent");
    const gaugeBar = root.querySelector<HTMLElement>("#gauge-bar");
    const lengthDisplay = root.querySelector<HTMLElement>("#length-estimate");
    const benchyDisplay = root.querySelector<HTMLElement>("#benchy-estimate");
    const formulaText = root.querySelector<HTMLElement>("#formula-text");

    let currentTare = 250;
    let currentBrand = "Bambu Lab";

    function updateCalculations() {
      if (!slider || !grossDisplay || !netDisplay || !percentDisplay || !gaugeBar || !lengthDisplay || !benchyDisplay || !formulaText) return;

      const gross = Number(slider.value);
      grossDisplay.textContent = `${gross} g`;

      const net = Math.max(0, gross - currentTare);
      netDisplay.textContent = `${net}`;

      const percent = Math.min(100, Math.round((net / 1000) * 100));
      percentDisplay.textContent = `${percent}%`;
      gaugeBar.style.width = `${percent}%`;

      // 1.75mm PLA: ~2.982 g per meter
      const meters = Math.round(net * 0.335);
      lengthDisplay.textContent = `~${meters} m`;

      // ~13g per typical Benchy
      const benchies = Math.floor(net / 13);
      benchyDisplay.textContent = `~${benchies} Benchies`;

      formulaText.textContent = `${gross}g gross - ${currentTare}g (${currentBrand}) = ${net}g net`;
    }

    brandButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        brandButtons.forEach((b) => {
          b.setAttribute("aria-checked", "false");
          b.className = "tare-brand-btn rounded-xl border px-3 py-1.5 text-xs font-semibold transition-all duration-200 border-border bg-background text-foreground hover:border-primary/40";
        });

        btn.setAttribute("aria-checked", "true");
        btn.className = "tare-brand-btn rounded-xl border px-3 py-1.5 text-xs font-semibold transition-all duration-200 border-primary bg-primary/15 text-primary-text ring-1 ring-primary/40 shadow-xs";

        currentTare = Number(btn.dataset.tare) || 250;
        currentBrand = btn.dataset.brand || "Bambu Lab";
        updateCalculations();
      });
    });

    slider?.addEventListener("input", updateCalculations);
  }

  initTareCalculator();
  document.addEventListener("astro:page-load", initTareCalculator);
</script>
