---
/**
 * Interactive Filament Drying & Moisture Assistant.
 * Built with SpoolSync's core drying engine to help makers dry and store
 * hygroscopic polymers (Nylon, PVA, PETG, TPU, PC, ASA, PLA) correctly.
 */
import { Icon } from "astro-icon/components";
import Button from "~/components/starwind/controls/Button/Button.astro";

interface MaterialDryingInfo {
  id: string;
  label: string;
  tempC: number;
  tempF: number;
  hours: number;
  moisture: "high" | "medium" | "low";
  description: string;
  symptoms: string;
}

const dryingData: readonly MaterialDryingInfo[] = [
  {
    id: "nylon",
    label: "Nylon (PA / PA-CF)",
    tempC: 80,
    tempF: 176,
    hours: 12,
    moisture: "high",
    description: "Extremely hygroscopic. Absorbs air moisture within hours, leading to severe foaming and steam bubbles.",
    symptoms: "Audible popping at the nozzle, heavy stringing, brittle prints.",
  },
  {
    id: "pva",
    label: "PVA / BVOH",
    tempC: 45,
    tempF: 113,
    hours: 6,
    moisture: "high",
    description: "Water-soluble support materials. High ambient humidity degrades solubility and causes nozzle jams.",
    symptoms: "Soft, sticky filament, extruder gear slipping, nozzle clogs.",
  },
  {
    id: "tpu",
    label: "TPU / TPE",
    tempC: 55,
    tempF: 131,
    hours: 6,
    moisture: "medium",
    description: "Flexible polyurethane absorbs water rapidly, creating excessive stringing and rough surface textures.",
    symptoms: "Extreme wispy stringing, porous layer lines, reduced elasticity.",
  },
  {
    id: "petg",
    label: "PETG / PCTG",
    tempC: 65,
    tempF: 149,
    hours: 6,
    moisture: "medium",
    description: "Moderate moisture uptake. Wet PETG causes oozing, surface blobbing, and weakened layer bonding.",
    symptoms: "Hairy stringing, blobbing on perimeters, cloudy transparency.",
  },
  {
    id: "pc",
    label: "Polycarbonate (PC)",
    tempC: 80,
    tempF: 176,
    hours: 8,
    moisture: "medium",
    description: "High-temperature engineering material that requires thorough drying to prevent delamination.",
    symptoms: "Layer splitting, micro-voids, reduced impact resistance.",
  },
  {
    id: "asa-abs",
    label: "ABS / ASA",
    tempC: 80,
    tempF: 176,
    hours: 4,
    moisture: "low",
    description: "Low moisture sensitivity, but absorbs water over weeks in humid workshops.",
    symptoms: "Surface pitting, weak layer adhesion, warping.",
  },
  {
    id: "pla",
    label: "PLA / PLA+",
    tempC: 45,
    tempF: 113,
    hours: 4,
    moisture: "low",
    description: "Low moisture absorption. Prolonged humidity causes filament brittleness and spool snapping.",
    symptoms: "Filament snaps inside reverse Bowden tubes or AMS feeders.",
  },
];
---

<section class="mt-20 scroll-mt-20" id="drying-guide-section">
  <div class="glass-surface relative overflow-hidden rounded-3xl border border-border/80 p-6 sm:p-10 shadow-layered">
    <!-- Ambient background glow -->
    <div class="pointer-events-none absolute -left-24 -top-24 size-60 rounded-full bg-primary/10 blur-3xl" aria-hidden="true"></div>

    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between border-b border-border/70 pb-6">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-primary-text">Workshop Drybox Intelligence</p>
        <h2 class="mt-1 text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
          Filament drying & moisture guide
        </h2>
        <p class="mt-2 text-sm text-muted-foreground sm:text-base max-w-xl leading-relaxed">
          SpoolSync flags hygroscopic spools that need drying right in your loaded inventory. Select a material below to inspect optimal drying settings and signs of wet filament.
        </p>
      </div>

      <!-- Moisture Risk Filter Pills -->
      <div class="mt-4 sm:mt-0 flex flex-wrap gap-1.5" role="group" aria-label="Filter materials by moisture risk">
        <button
          type="button"
          data-moisture-filter="all"
          aria-pressed="true"
          class="moisture-filter-btn rounded-full border border-primary bg-primary/15 px-3 py-1 text-xs font-semibold text-primary-text transition-all"
        >
          All
        </button>
        <button
          type="button"
          data-moisture-filter="high"
          aria-pressed="false"
          class="moisture-filter-btn rounded-full border border-border bg-background px-3 py-1 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground hover:border-primary/40"
        >
          High Risk
        </button>
        <button
          type="button"
          data-moisture-filter="medium"
          aria-pressed="false"
          class="moisture-filter-btn rounded-full border border-border bg-background px-3 py-1 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground hover:border-primary/40"
        >
          Medium
        </button>
        <button
          type="button"
          data-moisture-filter="low"
          aria-pressed="false"
          class="moisture-filter-btn rounded-full border border-border bg-background px-3 py-1 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground hover:border-primary/40"
        >
          Low
        </button>
      </div>
    </div>

    <!-- Interactive Grid of Materials -->
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="drying-cards-container">
      {dryingData.map((item) => (
        <article
          class="drying-card modern-card group relative flex flex-col justify-between rounded-2xl border border-border/80 bg-background/80 p-5 shadow-xs backdrop-blur-xs transition-all hover:border-primary/50 hover:shadow-md"
          data-moisture={item.moisture}
        >
          <div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-base font-bold text-foreground leading-snug group-hover:text-primary-text transition-colors">
                {item.label}
              </h3>
              {item.moisture === "high" && (
                <span class="inline-flex items-center gap-1 rounded-full border border-rose-500/30 bg-rose-500/10 px-2 py-0.5 text-[0.68rem] font-bold text-rose-800 dark:text-rose-300">
                  <Icon name="material-symbols:water-drop" class="size-3" /> High Risk
                </span>
              )}
              {item.moisture === "medium" && (
                <span class="inline-flex items-center gap-1 rounded-full border border-amber-500/30 bg-amber-500/10 px-2 py-0.5 text-[0.68rem] font-bold text-amber-800 dark:text-amber-300">
                  <Icon name="material-symbols:humidity-mid" class="size-3" /> Medium
                </span>
              )}
              {item.moisture === "low" && (
                <span class="inline-flex items-center gap-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 text-[0.68rem] font-bold text-emerald-800 dark:text-emerald-300">
                  <Icon name="material-symbols:humidity-low" class="size-3" /> Low
                </span>
              )}
            </div>

            <!-- Dryer Temp & Duration Specs -->
            <div class="mt-4 grid grid-cols-2 gap-2 text-xs">
              <div class="rounded-xl border border-border/60 bg-muted/40 p-2.5">
                <span class="text-[0.68rem] text-muted-foreground block font-medium">Dryer Temp</span>
                <span class="font-extrabold text-foreground text-sm mt-0.5 block font-mono">
                  {item.tempC} °C <span class="text-[0.7rem] font-normal text-muted-foreground">({item.tempF} °F)</span>
                </span>
              </div>
              <div class="rounded-xl border border-border/60 bg-muted/40 p-2.5">
                <span class="text-[0.68rem] text-muted-foreground block font-medium">Duration</span>
                <span class="font-extrabold text-foreground text-sm mt-0.5 block font-mono">
                  {item.hours} hours
                </span>
              </div>
            </div>

            <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
              {item.description}
            </p>
          </div>

          <div class="mt-4 border-t border-border/50 pt-2.5 text-[0.7rem]">
            <strong class="font-semibold text-foreground">Signs of moisture:</strong>
            <span class="text-muted-foreground ml-1">{item.symptoms}</span>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom integration callout -->
    <div class="mt-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 rounded-2xl border border-primary/25 bg-primary/10 p-4 text-xs">
      <div class="flex items-center gap-3">
        <div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-primary/20 text-primary-text">
          <Icon name="material-symbols:dry-cleaning" class="size-5" />
        </div>
        <div>
          <p class="font-bold text-foreground">Integrated into the Load & Sync drawer</p>
          <p class="text-muted-foreground text-[0.72rem]">When you load spools, SpoolSync groups spools that need drying and remembers your last drying dates.</p>
        </div>
      </div>
      <Button
        href="/load"
        color="primary"
        size="md"
        icon="material-symbols:arrow-forward"
        iconPosition="right"
        class="shrink-0 shadow-xs"
      >
        Open Drying Assistant
      </Button>
    </div>
  </div>
</section>

<script>
  function initDryingFilters() {
    const root = document.getElementById("drying-guide-section");
    if (!root) return;

    const filterButtons = root.querySelectorAll<HTMLButtonElement>(".moisture-filter-btn");
    const cards = root.querySelectorAll<HTMLElement>(".drying-card");

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.moistureFilter;
        if (!filter) return;

        filterButtons.forEach((b) => {
          b.setAttribute("aria-pressed", "false");
          b.className = "moisture-filter-btn rounded-full border border-border bg-background px-3 py-1 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground hover:border-primary/40";
        });

        btn.setAttribute("aria-pressed", "true");
        btn.className = "moisture-filter-btn rounded-full border border-primary bg-primary/15 px-3 py-1 text-xs font-semibold text-primary-text transition-all";

        cards.forEach((card) => {
          const moisture = card.dataset.moisture;
          if (filter === "all" || moisture === filter) {
            card.classList.remove("hidden");
          } else {
            card.classList.add("hidden");
          }
        });
      });
    });
  }

  initDryingFilters();
  document.addEventListener("astro:page-load", initDryingFilters);
</script>
