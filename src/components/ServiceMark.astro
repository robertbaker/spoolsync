---
/** A tool's logo: its bundled raster image when it has one, otherwise its icon. Decorative. */
import { Icon } from "astro-icon/components";
import type { SourceId } from "@spoolsync/core/core/model";
import { serviceLogoSrc } from "~/lib/service-logos";
import { serviceView } from "~/lib/services";

interface Props {
  id: SourceId;
  class?: string;
}

const { id, class: className = "size-5" } = Astro.props;
const src = serviceLogoSrc(id);
const icon = serviceView(id).icon;
---

{
  src ? (
    <img src={src} alt="" class:list={["shrink-0 object-contain", className]} loading="lazy" decoding="async" />
  ) : (
    <Icon name={icon} class:list={["shrink-0", className]} aria-hidden="true" />
  )
}
