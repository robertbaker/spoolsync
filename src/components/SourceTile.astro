---
/** A service in the Load page's picker. Selecting it opens that service's panel in the stage below. */
import IconAvatar from "~/components/starwind/controls/IconAvatar/IconAvatar.astro";

interface Props {
  id: string;
  label: string;
  kind: string;
  icon?: string;
  image?: string;
  api?: boolean;
  readonly?: boolean;
  /** A pill for file-only services: name and loaded count, no description. */
  compact?: boolean;
}

const { id, label, kind, icon, image, api = false, readonly = false, compact = false } = Astro.props;
---

<button
  type="button"
  data-tile={id}
  data-compact={compact ? "true" : undefined}
  data-api={api ? "true" : undefined}
  aria-expanded="false"
  aria-controls={id === "spoolman" ? "tour-load" : `${id}-panel`}
  class:list={[
    "source-tile group flex min-w-0 items-center border border-border/80 bg-card/90 text-left transition-all hover:border-primary/50 hover:bg-card hover:shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-expanded:border-primary/60 aria-expanded:bg-primary/10 aria-expanded:ring-1 aria-expanded:ring-primary/30",
    compact ? "source-tile--compact gap-2 rounded-xl px-2.5 py-2" : "gap-2.5 rounded-xl px-3 py-2.5",
  ]}
>
  {
    image ? (
      <IconAvatar color="primary" size="sm" containerSize="sm">
        <img slot="icon" src={image} alt="" class="size-5 object-contain" />
      </IconAvatar>
    ) : (
      <IconAvatar icon={icon} color="primary" size="sm" containerSize="sm" />
    )
  }
  {
    compact ? (
      <>
        <span class="whitespace-nowrap text-sm font-medium">{label}</span>
        <span class="sr-only">
          {api ? "API connection" : "File import"}{readonly ? ", read-only" : ""}
        </span>
      </>
    ) : (
      <span class="min-w-0 flex-1">
        <span class="block truncate text-sm font-semibold leading-tight">{label}</span>
        <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
          <span class="truncate">{kind}</span>
          {api && <span class="shrink-0 rounded-full bg-primary/10 px-1.5 text-[0.65rem] font-medium text-primary-text">API</span>}
        </span>
      </span>
    )
  }
  <span data-tile-status class={compact ? "shrink-0 empty:hidden" : "shrink-0 self-start empty:hidden"}></span>
</button>

<style>
  .source-tile {
    min-height: 2.75rem;
  }

  .source-tile--compact {
    background: var(--card);
    box-shadow: 0 1px 2px color-mix(in oklch, var(--foreground) 5%, transparent);
  }

  .source-tile--compact:hover {
    transform: translateY(-1px);
  }

  .source-tile[data-api="true"]:not([data-compact]) {
    min-height: 4rem;
  }

  .source-tile[data-tile-busy] {
    cursor: progress;
  }

  @media (prefers-reduced-motion: reduce) {
    .source-tile--compact:hover {
      transform: none;
    }
  }
</style>
