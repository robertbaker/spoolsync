---
/** Consistent heading block for app pages: optional eyebrow, title, description and trailing slot. */
interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  /** Element id for the h1, used by the guided tour. */
  titleId?: string;
  class?: string;
}

const { title, eyebrow, description, titleId, class: className } = Astro.props;
---

<header class:list={["max-w-3xl", className]}>
  {eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary-text">{eyebrow}</p>}
  <h1 id={titleId} class:list={["text-3xl font-extrabold tracking-tight sm:text-4xl", eyebrow && "mt-2"]}>{title}</h1>
  {description && <p class="mt-3 text-base text-muted-foreground sm:text-lg">{description}</p>}
  <slot />
</header>
