---
/**
 * The inventory workflow stepper: 1 Load, 2 Review, 3 Apply. Shared by the Load and Sync pages so
 * the two read as one flow. Server-rendered for the empty state; `scripts/workflow-steps.ts` then
 * fills in progress from the inventories loaded in this tab. Every step is a real link, so nothing
 * depends on scripting.
 */
import { Icon } from "astro-icon/components";
import { WORKFLOW_STEPS, type WorkflowStepId } from "~/config/site";

interface Props {
  /** The page this stepper is on. The Sync page highlights Review (or Apply when linked with #tour-apply). */
  current: WorkflowStepId | "sync";
  class?: string;
}

const { current: currentProp, class: className } = Astro.props;
const page: WorkflowStepId = currentProp === "sync" ? "review" : currentProp;
---

<nav aria-label="Inventory workflow" class:list={["workflow-steps", className]} data-workflow-steps data-page={page}>
  <ol class="workflow-steps__list">
    {
      WORKFLOW_STEPS.map((step, index) => (
        <li data-step={step.id} data-state={step.id === page ? "current" : "todo"} class="workflow-steps__item">
          <a href={step.href} aria-current={step.id === page ? "step" : undefined} class="workflow-steps__link">
            <span class="workflow-steps__badge" aria-hidden="true">
              <span class="workflow-steps__number">{index + 1}</span>
              <Icon name="material-symbols:check-rounded" class="workflow-steps__check size-4" />
            </span>
            <span class="workflow-steps__text">
              <span class="workflow-steps__label">{step.label}</span>
              <span class="workflow-steps__meta" data-step-meta>
                {step.hint}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
  <span class="sr-only" role="status" aria-live="polite" data-workflow-live></span>
</nav>

<script>
  import { wireWorkflowSteps } from "~/scripts/workflow-steps";

  wireWorkflowSteps();
</script>
