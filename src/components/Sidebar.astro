---
/**
 * Site navigation. One element, three presentations (styles in `styles/sidebar.css`):
 *
 * - 1024px and wider: a persistent left rail, expanded with labels or collapsed to icons.
 * - 768px to 1023px: a collapsed rail that expands over the page on hover or focus.
 * - Under 768px: a slide-over drawer (the Popover API) opened from the bottom bar's "More" button,
 *   plus the bottom bar itself for the four primary destinations.
 *
 * Entries come from `config/site.ts`, so the supported pages and the Load, Review, Apply steps have
 * one source. `scripts/sidebar.ts` adds the collapse state, step progress, badges and shortcuts.
 */
import { Icon } from "astro-icon/components";

import type { NavLink } from "~/components/starwind/types";
import ThemeToggle from "~/components/starwind/controls/ThemeToggle/ThemeToggle.astro";
import { WORKFLOW_STEPS } from "~/config/site";
import { isNavCurrent, workflowStepForPath } from "~/lib/sidebar";

interface Props {
  links: readonly NavLink[];
  /** The running SpoolSync version, shown beside the changelog entry. */
  version: string;
}

const { links, version } = Astro.props;
const pathname = Astro.url.pathname;
const currentStep = workflowStepForPath(pathname, "");
const bottomLinks = links.slice(0, 4);
---

<nav
  id="app-sidebar"
  class="app-sidebar"
  aria-label="Main"
  popover="auto"
  tabindex="-1"
  data-app-sidebar
  data-print="hide"
>
  <div class="sb-head">
    <a href="/" class="sb-brand" aria-label="SpoolSync home" title="SpoolSync home">
      <img src="/logo-mark.svg" alt="" width="32" height="32" class="sb-brand__mark" />
      <span class="sb-label sb-brand__name">Spool<span class="text-primary-text">Sync</span></span>
    </a>
    <button
      type="button"
      class="sb-iconbtn sb-collapse"
      data-sb-collapse
      aria-controls="app-sidebar"
      aria-expanded="true"
      aria-keyshortcuts="Control+B Meta+B"
      aria-label="Collapse sidebar"
      title="Collapse sidebar (Ctrl+B)"
    >
      <Icon name="material-symbols:chevron-left" class="sb-collapse__icon" aria-hidden="true" />
    </button>
    <button
      type="button"
      class="sb-iconbtn sb-close"
      data-sb-close
      aria-label="Close menu"
    >
      <Icon name="material-symbols:close" aria-hidden="true" />
    </button>
  </div>

  <ul class="sb-list" role="list">
    {
      links.map((link) => {
        const current = isNavCurrent(link, pathname);
        const isInventory = Boolean(link.matchPaths?.length);
        return (
          <li class="sb-item">
            <a
              href={link.href}
              class="sb-link"
              aria-current={current ? "page" : undefined}
              title={link.text}
              data-sb-link
              aria-describedby={isInventory ? "sb-loaded-desc" : undefined}
              {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              {link.icon && <Icon name={link.icon} class="sb-icon" aria-hidden="true" />}
              <span class="sb-label">{link.text}</span>
              {isInventory && (
                <span class="sb-badge" data-sb-loaded hidden aria-hidden="true" />
              )}
            </a>
            {isInventory && (
              <>
                <span id="sb-loaded-desc" class="sb-sr" data-sb-loaded-desc />
                <ol class="sb-steps" role="list" aria-label="Inventory steps">
                  {WORKFLOW_STEPS.map((step, index) => (
                    <li
                      class="sb-step"
                      data-sb-step={step.id}
                      data-state={step.id === currentStep ? "current" : "todo"}
                    >
                      <a
                        href={step.href}
                        class="sb-steplink"
                        aria-current={step.id === currentStep ? "step" : undefined}
                        aria-labelledby={`sb-step-label-${step.id}`}
                        aria-describedby={`sb-step-meta-${step.id}`}
                        data-sb-link
                      >
                        <span class="sb-step__dot" aria-hidden="true">
                          <span class="sb-step__num">{index + 1}</span>
                          <Icon name="material-symbols:check-rounded" class="sb-step__check" />
                        </span>
                        <span class="sb-step__text">
                          <span id={`sb-step-label-${step.id}`} class="sb-step__label">
                            {step.label}
                          </span>
                          <span id={`sb-step-meta-${step.id}`} class="sb-step__meta" data-sb-step-meta>
                            {step.hint}
                          </span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ol>
              </>
            )}
          </li>
        );
      })
    }
  </ul>

  <div class="sb-group">
    <p class="sb-group__title" id="sb-tools-title">Tools</p>
    <ul class="sb-list" role="list" aria-labelledby="sb-tools-title">
      <li class="sb-item">
        <button
          type="button"
          class="sb-link"
          data-open-palette
          data-sb-action
          aria-keyshortcuts="Control+K Meta+K"
          title="Command palette (Ctrl+K)"
        >
          <Icon name="material-symbols:search" class="sb-icon" aria-hidden="true" />
          <span class="sb-label">Command palette</span>
          <kbd class="sb-kbd" aria-hidden="true">Ctrl K</kbd>
        </button>
      </li>
      <li class="sb-item">
        <button type="button" class="sb-link" data-open-setup data-sb-action title="Setup guide">
          <Icon name="material-symbols:menu-book-outline" class="sb-icon" aria-hidden="true" />
          <span class="sb-label">Setup guide</span>
        </button>
      </li>
      <li class="sb-item">
        <button
          type="button"
          class="sb-link"
          data-open-changelog
          data-sb-action
          data-version={version}
          aria-label={`Changelog, SpoolSync version ${version}, show what is new`}
          title={`What is new (v${version})`}
        >
          <Icon name="material-symbols:release-alert-outline" class="sb-icon" aria-hidden="true" />
          <span class="sb-label" aria-hidden="true">Changelog</span>
          <span class="sb-badge sb-badge--new" data-sb-changelog-new hidden aria-hidden="true">New</span>
          <span class="sb-version" aria-hidden="true">v{version}</span>
        </button>
      </li>
      <li class="sb-item">
        <button type="button" class="sb-link" data-open-saved-data data-sb-action title="Saved settings">
          <Icon name="material-symbols:settings-outline" class="sb-icon" aria-hidden="true" />
          <span class="sb-label">Saved settings</span>
        </button>
      </li>
      <li class="sb-item">
        <button
          type="button"
          class="sb-link"
          data-open-shortcuts
          data-sb-action
          aria-keyshortcuts="?"
          title="Keyboard shortcuts"
        >
          <Icon name="material-symbols:keyboard-outline" class="sb-icon" aria-hidden="true" />
          <span class="sb-label">Keyboard shortcuts</span>
        </button>
      </li>
      <li class="sb-item">
        <button
          type="button"
          class="sb-link"
          data-install-app
          data-sb-action
          hidden
          title="Install SpoolSync as an app"
        >
          <Icon name="material-symbols:download-rounded" class="sb-icon" aria-hidden="true" />
          <span class="sb-label">Install app</span>
        </button>
      </li>
    </ul>
  </div>

  <div class="sb-foot">
    <div class="sb-row">
      <span class="sb-label sb-row__label" id="sb-theme-label">Theme</span>
      <ThemeToggle size="md" variant="outline" class="sb-themebtn" />
    </div>
    <button
      type="button"
      class="sb-link sb-units"
      data-sb-units
      title="Switch between grams and ounces"
    >
      <Icon name="material-symbols:straighten" class="sb-icon" aria-hidden="true" />
      <span class="sb-label" aria-hidden="true">Units</span>
      <span class="sb-chip" data-sb-units-value aria-hidden="true">g</span>
    </button>
  </div>
</nav>

<nav class="app-bottom-nav" aria-label="Quick links" data-print="hide" data-app-bottom-nav>
  <ul role="list">
    {
      bottomLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="bn-link"
            aria-current={isNavCurrent(link, pathname) ? "page" : undefined}
          >
            {link.icon && <Icon name={link.icon} class="bn-icon" aria-hidden="true" />}
            <span>{link.text}</span>
          </a>
        </li>
      ))
    }
    <li>
      <button
        type="button"
        class="bn-link"
        popovertarget="app-sidebar"
        popovertargetaction="toggle"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="app-sidebar"
        data-sb-open
      >
        <Icon name="material-symbols:menu" class="bn-icon" aria-hidden="true" />
        <span>More</span>
      </button>
    </li>
  </ul>
</nav>
