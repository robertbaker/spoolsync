---
import type { HTMLAttributes } from "astro/types";
import type { ImageMetadata } from "astro";
import SiteLogoImage from "../../../controls/SiteLogoImage/SiteLogoImage.astro";
import SiteLogoInline from "../../../controls/SiteLogoInline/SiteLogoInline.astro";
import { withPalette, type PaletteProps } from "../../../lib/palette.ts";

interface Props extends HTMLAttributes<"span">, PaletteProps {
  icon?: string | undefined;
  src?: string | ImageMetadata | undefined;
  text?: string | undefined;
  fallbackText?: string | undefined;
  fallbackClass?: string | undefined;
  transparent?: boolean | undefined;
  width?: number | undefined;
  height?: number | undefined;
  loading?: "eager" | "lazy" | undefined;
  fetchpriority?: "high" | "low" | "auto" | undefined;
  animate?: boolean | undefined;
}

const {
  icon,
  src,
  text,
  fallbackText = text,
  fallbackClass = "text-xl font-bold text-foreground",
  class: className,
  transparent,
  width,
  height,
  loading = "eager",
  fetchpriority = "high",
  animate = true,
  ...rest
} = Astro.props as Props;

const displayText = fallbackText || text;
const hasVisualLogoAsset = Boolean(icon || src);
const hasExplicitSizeClass = Boolean(className?.match(/(^|\s)(?:h-|max-h-|size-)/));
const logoClass = [
  hasVisualLogoAsset && !hasExplicitSizeClass ? "h-10 sm:h-12" : undefined,
  className?.trim(),
  hasVisualLogoAsset ? "w-auto max-w-full" : undefined,
]
  .filter(Boolean)
  .join(" ");
const srOnlyText = hasVisualLogoAsset ? displayText : undefined;
---

<span
  class:list={[
    "site-header-logo inline-flex max-w-full items-center",
    { "site-header-logo--animated": animate },
  ]}
  data-site-header-logo
  data-animate={animate ? "true" : undefined}
  {...withPalette(rest)}
>
  <slot>
    {
      icon ? (
        <SiteLogoInline
          logoName={icon}
          class={logoClass}
          fallbackText={displayText}
          srOnlyText={srOnlyText}
          {transparent}
        />
      ) : src ? (
        <SiteLogoImage
          {src}
          {width}
          {height}
          class={logoClass}
          fallbackText={displayText}
          srOnlyText={srOnlyText}
          {transparent}
          {loading}
          {fetchpriority}
        />
      ) : (
        displayText && <span class={fallbackClass}>{displayText}</span>
      )
    }
  </slot>
</span>

{
  animate && (
    <script>
      import { bootstrapHeaderLogoAnimation } from "./initHeaderLogoAnimation";
      bootstrapHeaderLogoAnimation();
    </script>
  )
}

<style is:global>
  .site-header-logo {
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-header-logo:active {
    transform: scale(0.96);
  }

  /* Core stroke drawing keyframes for emblem/mark */
  @keyframes headerLogoEmblemDraw {
    0% {
      stroke-dashoffset: var(--path-len, 800px);
      fill-opacity: 0;
      stroke-opacity: 0;
      stroke: var(--primary-text);
      stroke-width: 1.75px;
    }
    5% {
      stroke-opacity: 1;
      fill-opacity: 0;
      stroke: var(--primary-text);
      stroke-width: 1.75px;
    }
    65% {
      stroke-dashoffset: 0;
      fill-opacity: 0.2;
      stroke-opacity: 1;
      stroke: var(--primary-text);
      stroke-width: 1.75px;
    }
    85% {
      stroke-dashoffset: 0;
      fill-opacity: 0.9;
      stroke-opacity: 0.8;
      stroke: var(--primary-text);
      stroke-width: 1px;
    }
    100% {
      stroke-dashoffset: 0;
      fill-opacity: 1;
      stroke-opacity: 0;
      stroke: transparent;
      stroke-width: 0;
    }
  }

  /* Core stroke drawing keyframes for individual letters */
  @keyframes headerLogoLetterDraw {
    0% {
      stroke-dashoffset: var(--path-len, 350px);
      fill-opacity: 0;
      stroke-opacity: 0;
      stroke: var(--primary-text);
      stroke-width: 1.5px;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    5% {
      stroke-opacity: 1;
      fill-opacity: 0;
      stroke: var(--primary-text);
      stroke-width: 1.5px;
    }
    65% {
      stroke-dashoffset: 0;
      fill-opacity: 0.2;
      stroke-opacity: 1;
      stroke: var(--primary-text);
      stroke-width: 1.5px;
    }
    85% {
      stroke-dashoffset: 0;
      fill-opacity: 0.9;
      stroke-opacity: 0.8;
      stroke: var(--primary-text);
      stroke-width: 1px;
    }
    100% {
      stroke-dashoffset: 0;
      fill-opacity: 1;
      stroke-opacity: 0;
      stroke: transparent;
      stroke-width: 0;
    }
  }

  /* Sequential letter-by-letter handwriting effect */
  .site-header-logo.site-header-logo--animating #R5 path,
  .site-header-logo.site-header-logo--animating #R5-shadow,
  .site-header-logo.site-header-logo--animating #R5-fill {
    stroke-dasharray: var(--path-len, 800px);
    stroke-dashoffset: var(--path-len, 800px);
    animation: headerLogoEmblemDraw 1s cubic-bezier(0.25, 1, 0.5, 1) 1s both;
  }

  .site-header-logo.site-header-logo--animating #dot path,
  .site-header-logo.site-header-logo--animating #dot-shadow,
  .site-header-logo.site-header-logo--animating #dot-fill {
    stroke-dasharray: var(--path-len, 150px);
    stroke-dashoffset: var(--path-len, 150px);
    animation: headerLogoLetterDraw 0.5s cubic-bezier(0.25, 1, 0.5, 1) 1.85s both;
  }

  .site-header-logo.site-header-logo--animating #I path,
  .site-header-logo.site-header-logo--animating #I-shadow,
  .site-header-logo.site-header-logo--animating #I-fill {
    stroke-dasharray: var(--path-len, 350px);
    stroke-dashoffset: var(--path-len, 350px);
    animation: headerLogoLetterDraw 0.56s cubic-bezier(0.25, 1, 0.5, 1) 2.15s both;
  }

  .site-header-logo.site-header-logo--animating #n path,
  .site-header-logo.site-header-logo--animating #n-shadow,
  .site-header-logo.site-header-logo--animating #n-fill {
    stroke-dasharray: var(--path-len, 350px);
    stroke-dashoffset: var(--path-len, 350px);
    animation: headerLogoLetterDraw 0.56s cubic-bezier(0.25, 1, 0.5, 1) 2.45s both;
  }

  .site-header-logo.site-header-logo--animating #d path,
  .site-header-logo.site-header-logo--animating #d-shadow,
  .site-header-logo.site-header-logo--animating #d-fill {
    stroke-dasharray: var(--path-len, 350px);
    stroke-dashoffset: var(--path-len, 350px);
    animation: headerLogoLetterDraw 0.56s cubic-bezier(0.25, 1, 0.5, 1) 2.75s both;
  }

  .site-header-logo.site-header-logo--animating #u path,
  .site-header-logo.site-header-logo--animating #u-shadow,
  .site-header-logo.site-header-logo--animating #u-fill {
    stroke-dasharray: var(--path-len, 350px);
    stroke-dashoffset: var(--path-len, 350px);
    animation: headerLogoLetterDraw 0.56s cubic-bezier(0.25, 1, 0.5, 1) 3.05s both;
  }

  .site-header-logo.site-header-logo--animating #s-2 path,
  .site-header-logo.site-header-logo--animating #s-shadow-2,
  .site-header-logo.site-header-logo--animating #s-fill-2 {
    stroke-dasharray: var(--path-len, 350px);
    stroke-dashoffset: var(--path-len, 350px);
    animation: headerLogoLetterDraw 0.56s cubic-bezier(0.25, 1, 0.5, 1) 3.35s both;
  }

  .site-header-logo.site-header-logo--animating #t path,
  .site-header-logo.site-header-logo--animating #t-shadow,
  .site-header-logo.site-header-logo--animating #t-fill {
    stroke-dasharray: var(--path-len, 350px);
    stroke-dashoffset: var(--path-len, 350px);
    animation: headerLogoLetterDraw 0.56s cubic-bezier(0.25, 1, 0.5, 1) 3.65s both;
  }

  .site-header-logo.site-header-logo--animating #r path,
  .site-header-logo.site-header-logo--animating #r-shadow,
  .site-header-logo.site-header-logo--animating #r-fill {
    stroke-dasharray: var(--path-len, 350px);
    stroke-dashoffset: var(--path-len, 350px);
    animation: headerLogoLetterDraw 0.56s cubic-bezier(0.25, 1, 0.5, 1) 3.95s both;
  }

  .site-header-logo.site-header-logo--animating #i path,
  .site-header-logo.site-header-logo--animating #i-shadow,
  .site-header-logo.site-header-logo--animating #i-fill {
    stroke-dasharray: var(--path-len, 350px);
    stroke-dashoffset: var(--path-len, 350px);
    animation: headerLogoLetterDraw 0.56s cubic-bezier(0.25, 1, 0.5, 1) 4.25s both;
  }

  .site-header-logo.site-header-logo--animating #e path,
  .site-header-logo.site-header-logo--animating #e-shadow,
  .site-header-logo.site-header-logo--animating #e-fill {
    stroke-dasharray: var(--path-len, 350px);
    stroke-dashoffset: var(--path-len, 350px);
    animation: headerLogoLetterDraw 0.56s cubic-bezier(0.25, 1, 0.5, 1) 4.55s both;
  }

  .site-header-logo.site-header-logo--animating #s path,
  .site-header-logo.site-header-logo--animating #s-shadow,
  .site-header-logo.site-header-logo--animating #s-fill {
    stroke-dasharray: var(--path-len, 350px);
    stroke-dashoffset: var(--path-len, 350px);
    animation: headerLogoLetterDraw 0.64s cubic-bezier(0.25, 1, 0.5, 1) 4.85s both;
  }

  /* Fallback sequential delay for arbitrary vector SVGs */
  .site-header-logo.site-header-logo--animating svg g:not([id]) > path,
  .site-header-logo.site-header-logo--animating svg > path {
    stroke-dasharray: var(--path-len, 400px);
    stroke-dashoffset: var(--path-len, 400px);
    animation: headerLogoLetterDraw 0.64s cubic-bezier(0.25, 1, 0.5, 1) both;
  }
  .site-header-logo.site-header-logo--animating svg g:not([id]) > path:nth-of-type(1),
  .site-header-logo.site-header-logo--animating svg > path:nth-of-type(1) { animation-delay: 1s; }
  .site-header-logo.site-header-logo--animating svg g:not([id]) > path:nth-of-type(2),
  .site-header-logo.site-header-logo--animating svg > path:nth-of-type(2) { animation-delay: 1.32s; }
  .site-header-logo.site-header-logo--animating svg g:not([id]) > path:nth-of-type(3),
  .site-header-logo.site-header-logo--animating svg > path:nth-of-type(3) { animation-delay: 1.64s; }
  .site-header-logo.site-header-logo--animating svg g:not([id]) > path:nth-of-type(4),
  .site-header-logo.site-header-logo--animating svg > path:nth-of-type(4) { animation-delay: 1.96s; }
  .site-header-logo.site-header-logo--animating svg g:not([id]) > path:nth-of-type(5),
  .site-header-logo.site-header-logo--animating svg > path:nth-of-type(5) { animation-delay: 2.28s; }
  .site-header-logo.site-header-logo--animating svg g:not([id]) > path:nth-of-type(6),
  .site-header-logo.site-header-logo--animating svg > path:nth-of-type(6) { animation-delay: 2.60s; }
  .site-header-logo.site-header-logo--animating svg g:not([id]) > path:nth-of-type(7),
  .site-header-logo.site-header-logo--animating svg > path:nth-of-type(7) { animation-delay: 2.92s; }
  .site-header-logo.site-header-logo--animating svg g:not([id]) > path:nth-of-type(8),
  .site-header-logo.site-header-logo--animating svg > path:nth-of-type(8) { animation-delay: 3.24s; }

  /* Accessibility: Prefers reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .site-header-logo.site-header-logo--animating path,
    .site-header-logo.site-header-logo--animating polygon,
    .site-header-logo.site-header-logo--animating rect,
    .site-header-logo.site-header-logo--animating circle,
    .site-header-logo.site-header-logo--animating ellipse,
    .site-header-logo.site-header-logo--animating line,
    .site-header-logo.site-header-logo--animating polyline {
      animation: none !important;
      stroke-dashoffset: 0 !important;
      fill-opacity: 1 !important;
      stroke: transparent !important;
    }
  }
</style>
