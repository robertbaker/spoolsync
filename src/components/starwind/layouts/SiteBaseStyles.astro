---
/**
 * SiteBaseStyles — global base styles shared by SiteBaseLayout: marquee/shiki theme tokens,
 * reduced-motion handling, scroll-reveal keyframes + classes, view-transition fades, and small
 * utilities (.link, .hover-lift, .shine-effect, .animate-gradient). Rendered by SiteBaseLayout
 * unless `baseStyles={false}`; render it yourself in custom layouts.
 */
---

<style is:global>
  /* ==========================================================================
     starwind-ui — Shared site base styles
     ========================================================================== */

  :root {
    --shiki-foreground: #e1e4e8;
    --shiki-background: #24292e;
    --shiki-token-constant: #79b8ff;
    --shiki-token-string: #9ecbff;
    --shiki-token-comment: #b0b0b0;
    --shiki-token-keyword: #f97583;
    --shiki-token-parameter: #ffab70;
    --shiki-token-function: #b392f0;
    --shiki-token-string-expression: #9ecbff;
    --shiki-token-punctuation: #e1e4e8;
    --shiki-token-link: #79b8ff;

    --color-label-content: color-mix(in oklab, var(--foreground) 72%, transparent);
    --color-label-content-dark: color-mix(in oklab, var(--foreground) 72%, transparent);
  }

  .animate-marqueeLeft {
    animation: marqueeLeft var(--marquee-duration, 20s) linear infinite;
  }

  .animate-marqueeRight {
    animation: marqueeRight var(--marquee-duration, 20s) linear infinite;
  }

  @keyframes marqueeLeft {
    0% { left: 0%; }
    100% { left: -100%; }
  }

  @keyframes marqueeRight {
    0% { left: -100%; }
    100% { left: 0%; }
  }

  @layer base {
    html {
      font-family: var(--font-sans);
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
    }

    body {
      transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;
      transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
      transition-duration: 300ms;
    }

    .collapse-content { display: none; }
    .collapse input[type="checkbox"]:checked ~ .collapse-content,
    .collapse input[type="radio"]:checked ~ .collapse-content {
      display: block;
    }

    .sr-only:focus,
    .sr-only:active {
      position: static !important;
      width: auto !important;
      height: auto !important;
      margin: 0 !important;
      overflow: visible !important;
      clip: auto !important;
      white-space: normal !important;
      padding: 0.25rem 0.5rem;
      background: var(--card);
      color: var(--card-foreground);
      border-radius: 0.25rem;
      box-shadow: 0 1px 2px color-mix(in oklab, var(--scrim) 8%, transparent);
    }

    .link {
      display: inline-block;
      color: var(--primary-text);
      transition: color 0.2s ease;
    }
    .link:hover { color: var(--primary-accent); }

    mark { font-weight: 600; }
    img { max-width: 100%; height: auto; }

    @keyframes gradient {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .animate-gradient {
      background-size: 200% auto;
      animation: gradient 4s linear infinite;
    }

    .shine-effect {
      position: relative;
      overflow: hidden;
    }

    .shine-effect::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        to right,
        color-mix(in oklab, var(--card) 0%, transparent) 0%,
        color-mix(in oklab, var(--card) 10%, transparent) 50%,
        color-mix(in oklab, var(--card) 0%, transparent) 100%
      );
      transform: translateX(-100%);
      transition: transform 0s;
    }

    .shine-effect:hover::after {
      transform: translateX(100%);
      transition: transform 0.7s ease-in-out;
    }

    .hover-lift {
      transition: transform 0.3s ease-out, box-shadow 0.3s ease-out;
    }

    .hover-lift:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 25px -5px color-mix(in oklab, var(--scrim) 10%, transparent);
    }

    .dark .hover-lift:hover {
      box-shadow: 0 20px 25px -5px color-mix(in oklab, var(--scrim) 30%, transparent);
    }

    .transition-smooth {
      transition: all 0.3s ease-in-out;
    }

    @media (prefers-reduced-motion: reduce) {
      :not(svg, svg *, [data-animated-illustration], [data-animated-illustration] *),
      :not(svg, svg *, [data-animated-illustration], [data-animated-illustration] *)::before,
      :not(svg, svg *, [data-animated-illustration], [data-animated-illustration] *)::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }

      .hover-lift, .transition-smooth {
        transition: none !important;
      }
    }
  }

  body.site-body {
    --header-offset: 4rem;
  }

  body.site-body.has-fixed-header {
    padding-top: calc(var(--header-offset) + env(safe-area-inset-top, 0px));
  }

  @view-transition {
    navigation: auto;
  }

  @layer components {
    @keyframes reveal-fade-up {
      from { opacity: 0; transform: translateY(1.5rem); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes reveal-fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes reveal-scale-in {
      from { opacity: 0; transform: scale(0.92); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes reveal-slide-left {
      from { opacity: 0; transform: translateX(2rem); }
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes reveal-slide-right {
      from { opacity: 0; transform: translateX(-2rem); }
      to { opacity: 1; transform: translateX(0); }
    }

    .scroll-reveal { opacity: 0; will-change: opacity, transform; }
    .scroll-reveal.is-visible, .scroll-reveal[data-intersect-visible] { animation: reveal-fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

    .scroll-reveal-fade { opacity: 0; will-change: opacity; }
    .scroll-reveal-fade.is-visible, .scroll-reveal-fade[data-intersect-visible] { animation: reveal-fade-in 0.5s ease-out forwards; }

    .scroll-reveal-scale { opacity: 0; will-change: opacity, transform; }
    .scroll-reveal-scale.is-visible, .scroll-reveal-scale[data-intersect-visible] { animation: reveal-scale-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

    .scroll-reveal-left { opacity: 0; will-change: opacity, transform; }
    .scroll-reveal-left.is-visible, .scroll-reveal-left[data-intersect-visible] { animation: reveal-slide-left 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

    .scroll-reveal-right { opacity: 0; will-change: opacity, transform; }
    .scroll-reveal-right.is-visible, .scroll-reveal-right[data-intersect-visible] { animation: reveal-slide-right 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

    .scroll-reveal-delay-1 { animation-delay: 80ms; }
    .scroll-reveal-delay-2 { animation-delay: 160ms; }
    .scroll-reveal-delay-3 { animation-delay: 240ms; }
    .scroll-reveal-delay-4 { animation-delay: 320ms; }
    .scroll-reveal-delay-5 { animation-delay: 400ms; }

    @media (prefers-reduced-motion: reduce) {
      .scroll-reveal, .scroll-reveal-fade, .scroll-reveal-scale, .scroll-reveal-left, .scroll-reveal-right {
        opacity: 1; transform: none; animation: none !important; will-change: auto;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      html:active-view-transition main[data-pagefind-body] { animation: none !important; }
      html:not([data-view-transition="theme-toggle"])::view-transition-old(root),
      html:not([data-view-transition="theme-toggle"])::view-transition-new(root) { will-change: opacity; }
      html:not([data-view-transition="theme-toggle"])::view-transition-old(root) { animation: shared-page-transition-old 180ms ease-out forwards; }
      html:not([data-view-transition="theme-toggle"])::view-transition-new(root) { animation: shared-page-transition-new 240ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }
      
      html[data-view-transition="theme-toggle"]::view-transition-old(root),
      html[data-view-transition="theme-toggle"]::view-transition-new(root) {
        transition: opacity 400ms ease, transform 400ms ease, filter 400ms ease;
        will-change: opacity, transform, filter;
      }
      html[data-view-transition="theme-toggle"]::view-transition-old(root) { opacity: 1; transform: scale(1); filter: blur(0px) saturate(1); }
      html[data-view-transition="theme-toggle"]::view-transition-new(root) {
        opacity: 0; transform: scale(1.02); filter: blur(2px) saturate(0.92);
        animation: vt-fade-in 420ms cubic-bezier(0.2, 0.9, 0.2, 1) forwards;
      }

      @keyframes vt-fade-in {
        from { opacity: 0; transform: scale(1.02); filter: blur(2px) saturate(0.92); }
        to { opacity: 1; transform: scale(1); filter: blur(0px) saturate(1); }
      }
      @keyframes shared-page-transition-old {
        from { opacity: 1; }
        to { opacity: 0.08; }
      }
      @keyframes shared-page-transition-new {
        from { opacity: 0; }
        to { opacity: 1; }
      }
    }
  }
</style>
