---
/**
 * OverlayBadge Component
 *
 * A specialized badge component designed for overlay positioning on images, cards, and hero sections.
 * Features backdrop blur, absolute positioning, and glassmorphism effects for modern UI designs.
 *
 * @component
 * @example
 * ```astro
 * ---
 * import { OverlayBadge, OptimizedImage } from '~/components/ui';
 * import postImage from '~/assets/images/post.avifff';
 * ---
 *
 * <!-- Featured badge on blog post card -->
 * <div class="relative">
 *   <OptimizedImage src={postImage} alt="Post" />
 *   <OverlayBadge position="top-left" icon="material-symbols:check-circle">
 *     Featured
 *   </OverlayBadge>
 * </div>
 *
 * <!-- Date badge on related posts -->
 * <div class="relative">
 *   <OptimizedImage src={postImage} alt="Related Post" />
 *   <OverlayBadge position="bottom-left" variant="glass" icon="material-symbols:schedule">
 *     <time datetime="2025-01-15">Jan 15, 2025</time>
 *   </OverlayBadge>
 * </div>
 *
 * <!-- Call-to-action badge -->
 * <OverlayBadge
 *   variant="primary"
 *   tracking="wide"
 *   icon="material-symbols:bolt"
 *   position="center"
 * >
 *   Next up
 * </OverlayBadge>
 * ```
 *
 * @param {OverlayPosition} [position="top-left"] - Absolute positioning preset (top-left, top-right, bottom-left, bottom-right, center)
 * @param {OverlayVariant} [variant="glass"] - Visual style variant (glass, primary, white)
 * @param {OverlayTracking} [tracking="normal"] - Letter spacing preset for text (normal, wide, wider, widest)
 * @param {string} [icon] - Material Symbols icon name rendered by astro-icon
 * @param {boolean} [uppercase=true] - Applies uppercase text transformation
 * @param {string} [class] - Additional CSS classes for customization
 * @param {string} [dataTestid] - Test identifier for automated testing
 *
 * @features
 * - Five position presets for common overlay placements
 * - Three visual variants: glass (backdrop blur), primary (brand color), white (light overlay)
 * - Four letter spacing options for different content types
 * - Optional icon support with automatic sizing
 * - Backdrop blur effects for glassmorphism
 * - Uppercase transformation with tracking adjustments
 * - Border and background opacity controls
 * - Dark mode compatible with automatic adjustments
 * - Smooth hover transitions for interactive states
 *
 * @performance
 * - Pre-computed class mappings avoid runtime string concatenation
 * - Backdrop-filter GPU-accelerated for smooth rendering
 * - Minimal DOM structure with efficient CSS-only effects
 * - Icon components lazy-loaded only when needed
 *
 * @accessibility
 * - Semantic HTML structure with proper text hierarchy
 * - Time elements for date/time content
 * - ARIA labels inherited from content
 * - High contrast ratios maintained across variants
 * - Focus indicators for interactive elements (when used as links)
 * - Screen reader friendly content structure
 *
 * @dependencies
 * - astro-icon with the Material Symbols collection
 * - TailwindCSS for layout, backdrop effects, and utilities
 * - Astro framework for component rendering
 */

import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import type { ColorVariant } from "../../lib/colors";
import { getExtendedColorClasses } from "../../lib/colors";
import { partClasses, type ClassesProps } from "../../lib/classes";

type Part = "icon";

type OverlayPosition =
  | "top-left"
  | "top-right"
  | "bottom-left"
  | "bottom-right"
  | "center";
type OverlayVariant = ColorVariant | "glass" | "white";
type OverlayTracking = "normal" | "wide" | "wider" | "widest";

interface Props extends HTMLAttributes<"span">, ClassesProps<Part> {
  /**
   * Absolute positioning preset
   * @default "top-left"
   */
  position?: OverlayPosition;

  /**
   * Visual style variant or color
   * @default "glass"
   */
  variant?: OverlayVariant;

  /**
   * Letter spacing preset
   * @default "normal"
   */
  tracking?: OverlayTracking;

  /**
   * Icon name from astro-icon library
   */
  icon?: string;

  /**
   * Whether to apply uppercase text transformation
   * @default true
   */
  uppercase?: boolean;


  /**
   * Test identifier
   */
  dataTestid?: string;
}

const {
  position = "top-left",
  variant = "glass",
  tracking = "normal",
  icon,
  uppercase = true,
  class: className,
  dataTestid,
  classes,
  ...rest
} = Astro.props;

const cls = partClasses<Part>(classes);

/**
 * Position class mappings for absolute positioning
 * Maps semantic positions to TailwindCSS utility classes
 */
const positionClasses: Record<OverlayPosition, string> = {
  "top-left": "left-4 top-4",
  "top-right": "right-4 top-4",
  "bottom-left": "left-4 bottom-4",
  "bottom-right": "right-4 bottom-4",
  center: "left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2",
};

function getVariantClasses(v: OverlayVariant): string {
  if (v === "glass") {
    return "border-foreground/15 bg-background/40 text-foreground backdrop-blur-md";
  }
  if (v === "white") {
    return "border-primary-foreground/20 bg-primary-foreground/15 text-primary-foreground backdrop-blur-md";
  }
  const ext = getExtendedColorClasses(v);
  return `${ext.badgeBorder} backdrop-blur-md`;
}

/**
 * Tracking class mappings for letter spacing
 * Controls the spacing between letters for different visual effects
 */
const trackingClasses: Record<OverlayTracking, string> = {
  normal: "tracking-normal",
  wide: "tracking-wide", // 0.025em
  wider: "tracking-[0.25em]", // 0.25em
  widest: "tracking-[0.35em]", // 0.35em
};

/**
 * Pre-compute badge classes for optimal performance
 * Combines all style variants, positioning, and custom classes
 */
const badgeClasses = [
  "absolute",
  "inline-flex",
  "items-center",
  "gap-2",
  "rounded-full",
  "border",
  "px-3",
  "py-1",
  "text-xs",
  "font-semibold",
  uppercase ? "uppercase" : "",
  positionClasses[position as OverlayPosition],
  getVariantClasses(variant),
  trackingClasses[tracking as OverlayTracking],
  className,
]
  .filter(Boolean)
  .join(" ");
---

<span class={badgeClasses} data-testid={dataTestid} {...rest}>
  {icon && <Icon name={icon} class={cls("icon", "size-4")} aria-hidden="true" />}
  <slot />
</span>
