---
import TimelineStyles from "../../lib/styles/TimelineStyles.astro";
import type { HTMLAttributes } from "astro/types";
import { getTimelineClasses } from "./timelineVariants";
import { withPalette, type PaletteProps } from "../../lib/palette.ts";

interface Props extends HTMLAttributes<"ul">, PaletteProps {
  /**
   * Vertical orientation.
   * @default true
   */
  vertical?: boolean;
  /**
   * Horizontal orientation (overrides vertical if true).
   * @default false
   */
  horizontal?: boolean;
  /**
   * Responsive layout: Vertical on mobile, horizontal on desktop.
   * @default false
   */
  responsive?: boolean;
  /**
   * Compact mode (less spacing).
   */
  compact?: boolean;
  /**
   * Snap icon to center.
   */
  snapIcon?: boolean;

  [key: string]: unknown;
}

const {
  vertical = true,
  horizontal = false,
  responsive = false,
  compact = false,
  snapIcon = false,
  class: className,
  ...rest
} = Astro.props;

// Determine effective vertical state.
// If horizontal is true, vertical is false.
// If vertical is passed explicitly as true, but horizontal is also true, horizontal wins.
// If responsive is true, specialized classes are generated by helper.

// We pass 'true' for vertical defaults if nothing else is set.
const isVertical = !horizontal && vertical;

const timelineClasses = getTimelineClasses(
  isVertical,
  compact,
  className ?? undefined,
  responsive,
);
const finalClasses = snapIcon
  ? `${timelineClasses} timeline-snap-icon`
  : timelineClasses;
---

<TimelineStyles />

<ul class={finalClasses} {...withPalette(rest)}>
  <slot />
</ul>
