---
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { resolveOptimizedImageMimeType } from "./imageMime";

interface Props {
  /**
   * Page title
   */
  title: string;

  /**
   * Meta description
   */
  description: string;

  /**
   * Optional blog post data for article metadata
   */
  post?: CollectionEntry<"blog">;

  /**
   * Site URL used in title suffix (e.g. "example.com")
   */
  siteUrl: string;

  /**
   * Site or brand name used in structured data and Open Graph metadata.
   */
  siteName?: string;

  /**
   * Twitter/X handle (e.g. "@example")
   */
  twitterHandle?: string;

  /**
   * Social profile URLs for Organization structured data.
   */
  sameAs?: string[];

  /** Business phone number in E.164 format for Organization structured data. */
  telephone?: string;

  /**
   * Custom OG image URL for non-blog pages (absolute URL or site-relative path).
   * Blog posts automatically use their coverImage; this provides a fallback
   * for regular pages shared on social media.
   */
  image?: string | ImageMetadata;

  /**
   * Alt text for the OG image (improves accessibility in social previews)
   */
  imageAlt?: string;

  /**
   * Whether the site has an RSS feed. When true, a `<link rel="alternate">`
   * for `/rss.xml` is rendered.
   * @default false
   */
  hasRss?: boolean;

  /**
   * Optional robots directive override.
   */
  robots?: string;
}

const {
  title,
  description,
  post,
  siteUrl,
  siteName = siteUrl,
  twitterHandle,
  sameAs = [],
  telephone,
  image,
  imageAlt,
  hasRss = false,
  robots = "index, follow, max-image-preview:large, max-snippet:-1",
} = Astro.props;

const siteBaseUrl = Astro.site ?? new URL(siteUrl.startsWith("http") ? siteUrl : `https://${siteUrl}`);
const canonical = new URL(Astro.url.pathname, siteBaseUrl);

const formattedTitle =
  title.includes(siteName) || title.includes(siteUrl) ? title : `${title} | ${siteName}`;

/** Requested social-card size (1.91:1). Sources smaller than this are not upscaled. */
const OG_IMAGE_WIDTH = 1200;
const OG_IMAGE_HEIGHT = 630;

const ogTitle = formattedTitle;
const ogType = post ? "article" : "website";

let ogImageHref = "";
let ogImageWidth: number | undefined;
let ogImageHeight: number | undefined;
let ogImageMimeType: string | undefined;

// A remote/string image is used verbatim. Astro-owned images are transcoded to AVIF
// during prerendering. Non-prerendered routes omit Astro-owned social images because
// the worker image service cannot transcode AVIF at request time.
const ogImageSource = post?.data.coverImage ?? (typeof image === "string" ? undefined : image);

if (ogImageSource && Astro.isPrerendered) {
  const optimizedOg = await getImage({
    src: ogImageSource,
    format: "avif",
    quality: 80,
    width: OG_IMAGE_WIDTH,
    height: OG_IMAGE_HEIGHT,
    fit: "cover",
  });
  ogImageHref = new URL(optimizedOg.src, siteBaseUrl).href;
  ogImageMimeType = resolveOptimizedImageMimeType(optimizedOg.src, ogImageSource.format);
  // `attributes` echoes the requested size, so it cannot be trusted here. Astro never
  // upscales past the source, so the emitted file is clamped to the source's own
  // dimensions — report that instead, since crawlers lay the card out from these
  // numbers and a source smaller than 1200x630 otherwise advertises a size it isn't.
  ogImageWidth = Math.min(OG_IMAGE_WIDTH, ogImageSource.width);
  ogImageHeight = Math.min(OG_IMAGE_HEIGHT, ogImageSource.height);
} else if (typeof image === "string") {
  ogImageHref = image.startsWith("http") ? image : new URL(image, siteBaseUrl).href;
}

const ogImageAlt = imageAlt ?? post?.data.coverAlt ?? description;

const articleDate = post ? new Date(post.data.pubDate).toISOString() : undefined;
const articleAuthor = post ? post.data.author : undefined;
const rootUrl = new URL("/", siteBaseUrl).href;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${rootUrl}#website`,
      name: siteName,
      url: rootUrl,
      publisher: { "@id": `${rootUrl}#organization` },
    },
    {
      "@type": "Organization",
      "@id": `${rootUrl}#organization`,
      name: siteName,
      url: rootUrl,
      ...(telephone ? { telephone } : {}),
      ...(sameAs.length > 0 ? { sameAs } : {}),
    },
  ],
};
---

<!-- Canonical URL -->
<link rel="canonical" href={canonical.href} />

<!-- Robot directives -->
<meta name="robots" content={robots} />

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical.href} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content={siteName} />
{ogImageHref && <meta property="og:image" content={ogImageHref} />}
{ogImageHref && ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
{ogImageHref && ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
{ogImageHref && ogImageMimeType && <meta property="og:image:type" content={ogImageMimeType} />}
{ogImageHref && <meta property="og:image:alt" content={ogImageAlt} />}
{
  articleDate && (
    <meta property="article:published_time" content={articleDate} />
  )
}
{articleAuthor && <meta property="article:author" content={articleAuthor} />}

<!-- Twitter -->
<meta name="twitter:card" content={ogImageHref ? "summary_large_image" : "summary"} />
<meta name="twitter:url" content={canonical.href} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={description} />
{ogImageHref && <meta name="twitter:image" content={ogImageHref} />}
{ogImageHref && <meta name="twitter:image:alt" content={ogImageAlt} />}
{twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
{twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}

<!-- Structured Data -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />

<!-- Links -->
{hasRss && (
  <link
    rel="alternate"
    type="application/rss+xml"
    href="/rss.xml"
    title={`${siteName} RSS Feed`}
  />
)}
