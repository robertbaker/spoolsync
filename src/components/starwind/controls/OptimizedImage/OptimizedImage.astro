---
/**
 * Optimized Image Component
 *
 * Imported metadata and remote HTTP images use Astro's configured image service.
 * Public paths, relative URLs, and browser-managed sources render native images;
 * provide dimensions when known to reserve space without runtime asset lookups.
 *
 * Features:
 * - Responsive srcset generation
 * - Lazy loading by default (priority for critical images)
 * - Cloudflare image optimization
 * - Accessibility with required alt text
 *
 * @example
 * ```astro
 * <!-- Standard lazy-loaded image -->
 * <OptimizedImage src={image} alt="Description" />
 *
 * <!-- Critical/above-fold image (eager load) -->
 * <OptimizedImage src={image} alt="Hero" priority />
 * ```
 */

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { ComponentProps } from "astro/types";
import { getNativeImageAttributes, isNativeImageSource } from "./imageSources";

type ImageProps = ComponentProps<typeof Image>;

interface Props {
  src?: string | ImageMetadata | null | undefined;
  alt: string;
  priority?: boolean;
  fetchpriority?: "high" | "low" | "auto";
  width?: number | undefined;
  height?: number | undefined;
  class?: string | undefined;
  widths?: number[];
  sizes?: string;
  quality?: number;
  [key: string]: unknown;
}

const {
  src,
  alt,
  priority = false,
  fetchpriority,
  width,
  height,
  class: className,
  widths = [240, 320, 480, 640, 768, 960, 1280, 1600, 1920, 2048],
  sizes = "auto, 100vw",
  quality = 80,
  ...rest
} = Astro.props;

const isRemote = typeof src === "string" && /^(https?:)?\/\//i.test(src);
const needsInferSize = isRemote && (width === undefined || height === undefined);
const effectiveFetchPriority = fetchpriority ?? (priority ? "high" : undefined);
const isHighPriority = priority || effectiveFetchPriority === "high";
const effectiveLoading = isHighPriority ? "eager" : ((rest.loading as "lazy" | "eager" | undefined) ?? "lazy");
const effectiveDecoding = isHighPriority ? "sync" : "async";

const nativeImageProps = getNativeImageAttributes({
  alt,
  width,
  height,
  class: className,
  loading: effectiveLoading,
  decoding: effectiveDecoding,
  ...(effectiveFetchPriority && { fetchpriority: effectiveFetchPriority }),
  ...rest,
});

// Build image props object with required properties
const imageProps = {
  src,
  alt,
  loading: effectiveLoading as "eager" | "lazy",
  decoding: effectiveDecoding as "sync" | "async",
  ...(effectiveFetchPriority && { fetchpriority: effectiveFetchPriority as "high" | "low" | "auto" }),
  ...(width !== undefined && { width }),
  ...(height !== undefined && { height }),
  ...(needsInferSize && { inferSize: true as const }),
  ...(className !== undefined && { class: className }),
  ...rest,
  widths,
  sizes,
  quality,
  format: typeof src !== "string" && src?.format === "svg" ? "svg" as const : "avif" as const,
} as ImageProps;
---

{isNativeImageSource(src) ? (
  <img src={typeof src === "string" && src ? src : undefined} {...nativeImageProps} />
) : (
  <Image {...imageProps} />
)}
