---
import FlowSteps from "~/components/FlowSteps.astro";
import PageHeader from "~/components/PageHeader.astro";
import Button from "~/components/starwind/controls/Button/Button.astro";
import IconAvatar from "~/components/starwind/controls/IconAvatar/IconAvatar.astro";
import Container from "~/components/starwind/controls/Container/Container.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { SITE_TITLE } from "~/config";
---

<BaseLayout
  title={`Sync — ${SITE_TITLE}`}
  description="Steps 2 and 3 of 3: match spools across your loaded inventories, resolve differences, then apply or download the changes."
>
  <div class="relative isolate overflow-hidden">
    <div class="hero-glow-backdrop" aria-hidden="true"></div>

    <Container class="relative z-10 py-10 sm:py-14">
    <FlowSteps current="sync" class="mb-6" />
    <PageHeader
      eyebrow="Steps 2 and 3 of 3"
      title="Sync"
      titleId="tour-sync"
      description="Spools are matched across your loaded inventories. Pick a value wherever services disagree, then apply or download your changes."
    />

    <!-- Neutral placeholder, same footprint as the empty state, until the script knows what is loaded. -->
    <div id="sync-loading" class="mt-10" aria-busy="true">
      <div class="glass-surface mx-auto grid max-w-xl gap-3.5 rounded-3xl border border-dashed border-primary/20 p-8 sm:p-12" role="presentation">
        <span class="skeleton-line"></span>
        <span class="skeleton-line"></span>
        <span class="skeleton-line"></span>
      </div>
      <p class="sr-only">Loading your inventories…</p>
    </div>

    <div id="sync-empty" class="mt-10" hidden>
      <div class="glass-surface mx-auto flex max-w-xl flex-col items-center rounded-3xl border border-dashed border-primary/30 p-8 sm:p-12 text-center shadow-layered" role="status">
        <div class="relative">
          <div class="absolute -inset-2 rounded-full bg-primary/20 blur-lg" aria-hidden="true"></div>
          <IconAvatar icon="material-symbols:sync-alt" color="primary" containerSize="xl" size="xl" rounded="full" class="relative" />
        </div>
        <h2 id="sync-empty-title" class="mt-6 text-2xl font-extrabold tracking-tight">Nothing loaded yet</h2>
        <p id="sync-empty-body" class="mt-2 text-muted-foreground text-sm sm:text-base leading-relaxed max-w-md">
          Load at least two services to match spools and compare differences side by side.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <Button href="/load" color="primary" size="lg" icon="material-symbols:upload-file-outline-rounded" iconPosition="left" class="shadow-md shadow-primary/25 hover:shadow-lg hover:shadow-primary/35 hover:-translate-y-0.5 transition-all">
            Load inventories
          </Button>
          <Button type="button" variant="outline" size="lg" id="try-sample-sync" icon="material-symbols:play-circle-outline-rounded" iconPosition="left" class="border-primary/30 hover:border-primary/60 hover:bg-primary/5 transition-all" hidden>
            Try sample data
          </Button>
        </div>
      </div>
    </div>

    <div id="sync-app" hidden>
      <div id="sample-banner" class="mt-8" hidden></div>
      <div id="review-live" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
      <div id="sync-summary" class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4" aria-live="polite"></div>
      <div id="sync-chart" class="mt-6 rounded-xl border p-4" hidden></div>
      <div id="sync-problems" class="mt-6"></div>

      <div id="match-answers" class="mt-6" hidden></div>

      <section id="suggestions-section" class="mt-12 scroll-mt-24" aria-labelledby="suggestions-heading" hidden>
        <h2 id="suggestions-heading" class="text-2xl">Possible matches</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          These spools look similar but don't share an ID. Confirm or reject each pair—SpoolSync remembers your choice.
        </p>
        <div id="review-controls" class="mt-4 flex flex-wrap items-center gap-3"></div>
        <div id="suggestions-bulk" class="mt-4 flex flex-wrap items-center gap-2" aria-live="polite"></div>
        <div id="suggestions" class="mt-4 grid gap-4"></div>
      </section>

      <section id="tour-differences" class="mt-12" aria-labelledby="differences-heading">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="differences-heading" class="text-2xl">Differences</h2>
          <div id="filters" class="flex flex-wrap gap-2" role="group" aria-label="Show"></div>
        </div>
        <input
          id="group-search"
          type="search"
          placeholder="Filter spools by brand, material, name or ID... (/)"
          aria-label="Filter spools"
          class="field-input mt-4 w-full py-1.5 text-sm sm:max-w-sm"
        />
        <div id="bulk" class="mt-4 flex flex-wrap gap-2"></div>
        <div id="groups" class="mt-4 grid gap-4"></div>
      </section>

      <section id="tour-apply" class="app-card mt-12 scroll-mt-24" aria-labelledby="apply-heading">
        <h2 id="apply-heading" class="text-2xl">Apply</h2>
        <div id="apply" class="mt-4 grid gap-6"></div>
      </section>
      <div
        id="sync-bar"
        hidden
        class="sticky bottom-[var(--bar-bottom)] z-10 mt-6 flex flex-wrap items-center justify-between gap-x-3 gap-y-2 sm:flex-nowrap rounded-2xl border bg-card/95 p-2.5 pl-4 shadow-lg backdrop-blur supports-[backdrop-filter]:bg-card/80 sm:p-3 sm:pl-5 md:pr-[var(--bar-end-pad)]"
      >
        <p id="sync-bar-summary" class="min-w-0 flex-1 text-xs text-muted-foreground sm:text-sm" aria-live="polite"></p>
        <div class="flex shrink-0 flex-wrap items-center justify-end gap-2">
          <Button id="sync-bar-review" href="#suggestions-section" color="warning" size="sm" class="shrink-0" icon="material-symbols:arrow-upward-rounded" iconPosition="right" hidden>
            Review matches
          </Button>
          <Button id="sync-bar-apply" href="#tour-apply" color="primary" size="sm" class="shrink-0" icon="material-symbols:arrow-downward-rounded" iconPosition="right" hidden>
            Jump to apply
          </Button>
        </div>
      </div>
    </div>
  </Container>
  </div>
</BaseLayout>

<script>
  import "~/scripts/sync";
</script>
