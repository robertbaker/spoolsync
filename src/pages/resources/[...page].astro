---
import { newestFirst } from "~/lib/blog/order";
import BlogPostCard from "~/components/starwind/blocks/blog/PostCard/BlogPostCard.astro";
import Button from "~/components/starwind/controls/Button/Button.astro";
import CompactPostCard from "~/components/starwind/blocks/blog/PostCard/CompactPostCard.astro";
import FeaturedPostCard from "~/components/starwind/blocks/blog/PostCard/FeaturedPostCard.astro";
import Pagination from "~/components/starwind/controls/Pagination/Pagination.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPathsOptions, Page } from "astro";
import { getReadingTime } from "~/components/starwind/lib/format";
import { BLOG_PAGE_SIZE } from "~/config/blog-pagination";
import ArchiveHero from "~/components/resources/ArchiveHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const BLOG_META = {
  title: "Resources — SpoolSync",
  description:
    "Release notes, guides, and write-ups on syncing filament inventory across Spoolman, Spoolio, TigerTag, and more.",
  eyebrow: "Guides & release notes",
  heading: "SpoolSync Resources",
  subheading:
    "Guides, release notes, and notes on keeping your filament inventory in sync.",
};

const TOPIC_PRIORITY = ["Guides", "Releases", "CLI", "Integrations", "3D Printing"] as const;

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const blogPosts = await getCollection("blog");
  const sortedPosts = blogPosts.sort(newestFirst);

  return paginate(sortedPosts, { pageSize: BLOG_PAGE_SIZE, props: { allBlogPosts: sortedPosts } });
}

interface Props {
  page: Page<CollectionEntry<"blog">>;
  allBlogPosts?: CollectionEntry<"blog">[];
}

const { page, allBlogPosts: passedPosts } = Astro.props as Props;

const allBlogPosts =
  passedPosts ??
  (await getCollection("blog")).sort(newestFirst);
const featuredPost = page.currentPage === 1 ? page.data[0] : undefined;
const compactPosts = page.currentPage === 1 ? page.data.slice(1, 3) : [];
const gridPosts = page.currentPage === 1 ? page.data.slice(3) : page.data;
const allTags = Array.from(
  new Set(allBlogPosts.flatMap((entry: CollectionEntry<"blog">) => entry.data.tags ?? [])),
).filter((tag): tag is string => typeof tag === "string" && tag.length > 0);
const heroTags = [...allTags]
  .sort((left: string, right: string) => {
    const leftPriority = TOPIC_PRIORITY.indexOf(left as (typeof TOPIC_PRIORITY)[number]);
    const rightPriority = TOPIC_PRIORITY.indexOf(right as (typeof TOPIC_PRIORITY)[number]);

    if (leftPriority !== -1 || rightPriority !== -1) {
      if (leftPriority === -1) return 1;
      if (rightPriority === -1) return -1;
      return leftPriority - rightPriority;
    }

    return left.localeCompare(right);
  })
  .slice(0, 8);
const currentRangeLabel =
  page.start === page.end
    ? `Showing article ${page.start + 1} of ${page.total}`
    : `Showing articles ${page.start + 1}–${page.end + 1} of ${page.total}`;
const currentPageLabel = `Page ${page.currentPage} of ${page.lastPage}`;
const archiveTitle =
  page.currentPage === 1 ? BLOG_META.title : `${BLOG_META.title} — Page ${page.currentPage}`;
const archiveDescription =
  page.currentPage === 1
    ? BLOG_META.description
    : `Page ${page.currentPage} of the resource archive.`;
---

<BaseLayout
  title={archiveTitle}
  description={archiveDescription}
  {...(featuredPost
    ? { image: featuredPost.data.coverImage, imageAlt: featuredPost.data.coverAlt }
    : {})}
>
  <ArchiveHero meta={BLOG_META} {page} {allTags} {heroTags} {currentPageLabel} />

  {
    featuredPost && (
      <section class="bg-background py-14">
        <div
          class:list={[
            "mx-auto grid max-w-6xl gap-6 px-4 lg:px-8",
            compactPosts.length > 0 && "lg:grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)]",
          ]}
        >
          <h2 class="sr-only">Featured posts</h2>
          <FeaturedPostCard
            title={featuredPost.data.title}
            description={featuredPost.data.description}
            id={featuredPost.id}
            coverImage={featuredPost.data.coverImage}
            coverAlt={featuredPost.data.coverAlt}
            pubDate={new Date(featuredPost.data.pubDate)}
            author={featuredPost.data.author}
            tags={featuredPost.data.tags ?? []}
            readingMinutes={getReadingTime(featuredPost.body ?? "")}
          />
          {
            compactPosts.length > 0 && (
              <div class="flex flex-col gap-6">
                {compactPosts.map((post: CollectionEntry<"blog">) => (
                  <CompactPostCard
                    title={post.data.title}
                    id={post.id}
                    coverImage={post.data.coverImage}
                    coverAlt={post.data.coverAlt}
                    tags={post.data.tags ?? []}
                  />
                ))}
              </div>
            )
          }
        </div>
      </section>
    )
  }

  {
    gridPosts.length > 0 && (
      <section id="articles" class="bg-background pb-20">
        <div class="mx-auto max-w-6xl px-4 lg:px-8">
          <div class="mb-10 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-3xl">
              <p class="text-xs font-semibold uppercase tracking-[0.3em] text-primary-text">
                {page.currentPage === 1 ? "Archive" : `Archive · ${currentPageLabel}`}
              </p>
              <h2 class="mt-3 text-3xl font-extrabold text-foreground md:text-4xl">
                {
                  page.currentPage === 1
                    ? "All posts"
                    : currentRangeLabel
                }
              </h2>
              <p class="mt-3 text-base text-muted-foreground md:text-lg">
                {
                  page.currentPage === 1
                    ? "Start with the latest post, or filter by topic above."
                    : "Browse the archive or filter by topic above."
                }
              </p>
            </div>
            <div class="flex flex-col gap-3 sm:items-start lg:items-end">
              {
                page.lastPage > 1 && (
                  <p class="text-sm font-medium text-muted-foreground">{currentPageLabel}</p>
                )
              }
              <Button href="/cli" variant="solid" color="primary">
                Try the CLI
              </Button>
            </div>
          </div>

          <div class="grid gap-8 sm:grid-cols-2 xl:grid-cols-3">
            {gridPosts.map((post: CollectionEntry<"blog">, index: number) => (
              <BlogPostCard
                title={post.data.title}
                description={post.data.description}
                id={post.id}
                coverImage={post.data.coverImage}
                coverAlt={post.data.coverAlt}
                pubDate={new Date(post.data.pubDate)}
                author={post.data.author}
                tags={post.data.tags ?? []}
                index={index}
                readingMinutes={getReadingTime(post.body ?? "")}
              />
            ))}
          </div>

          {
            page.lastPage > 1 && (
              <div class="mt-14 flex flex-col gap-4 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between">
                <p
                  class="text-sm text-muted-foreground"
                  aria-label={`Pagination context: ${currentPageLabel}. ${currentRangeLabel}.`}
                >
                  {currentPageLabel} · {currentRangeLabel}
                </p>
                <Pagination page={page} />
              </div>
            )
          }
        </div>
      </section>
    )
  }
</BaseLayout>
