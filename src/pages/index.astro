---
import { Icon } from "astro-icon/components";
import Button from "~/components/starwind/controls/Button/Button.astro";
import Container from "~/components/starwind/controls/Container/Container.astro";
import SectionHeader from "~/components/starwind/controls/SectionHeader/SectionHeader.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ServiceMatrix from "~/components/home/ServiceMatrix.astro";
import HeroShowcase from "~/components/home/HeroShowcase.astro";
import SyncVisualizer from "~/components/home/SyncVisualizer.astro";
import FilamentPalette from "~/components/home/FilamentPalette.astro";
import TareCalculator from "~/components/home/TareCalculator.astro";
import PrintEstimator from "~/components/home/PrintEstimator.astro";
import DryingGuide from "~/components/home/DryingGuide.astro";
import FaqSection from "~/components/home/FaqSection.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "~/config";
import { SERVICE_COUNT_WORD } from "~/lib/services";

---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="relative isolate overflow-hidden">
    <div class="hero-glow-backdrop" aria-hidden="true"></div>

    <Container class="relative z-10 py-12 sm:py-16">
      <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_26rem]">
        <div class="max-w-3xl" id="tour-overview">
          <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl text-balance">
            Bring your spool lists together.
          </h1>
          <p class="mt-4 max-w-2xl text-lg sm:text-xl text-muted-foreground leading-relaxed">
            Compare filament inventories across {SERVICE_COUNT_WORD} tools, review every difference, then update a service or download a file.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <Button
              href="/load"
              color="primary"
              size="lg"
              icon="material-symbols:upload-file-outline-rounded"
              iconPosition="left"
              class="shadow-md shadow-primary/20 transition-all hover:shadow-lg hover:shadow-primary/30 hover:-translate-y-0.5"
            >
              Load inventories
            </Button>
            <Button
              href="/load?sample=1"
              variant="outline"
              size="lg"
              icon="material-symbols:play-circle-outline-rounded"
              iconPosition="left"
              class="border-primary/30 hover:border-primary/60 hover:bg-primary/5 transition-all hover:-translate-y-0.5"
            >
              Explore sample inventories
            </Button>
            <Button
              href="/cli"
              variant="ghost"
              size="lg"
              icon="material-symbols:terminal"
              iconPosition="left"
              class="text-muted-foreground hover:text-foreground"
            >
              Use the CLI
            </Button>
          </div>

          <div class="mt-7 flex flex-wrap items-center gap-3 border-t pt-4 text-sm text-muted-foreground">
            <span class="font-semibold text-foreground">No SpoolSync account or inventory server.</span>
            <a href="#supported-tools" class="inline-flex min-h-11 items-center font-semibold text-primary-text hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
              See supported tools and formats <Icon name="material-symbols:arrow-forward-rounded" class="ml-1 size-4" />
            </a>
          </div>
        </div>

        <HeroShowcase />
      </div>

      <ul class="glass-surface mt-12 grid gap-4 rounded-2xl border border-primary/15 p-4 shadow-xs sm:grid-cols-3 sm:divide-x sm:divide-border/60 sm:p-5">
        <li class="flex items-start gap-3 sm:px-4 sm:first:pl-0 sm:last:pr-0">
          <Icon name="material-symbols:lock-outline" class="mt-0.5 size-5 shrink-0 text-primary-text" aria-hidden="true" />
          <div>
            <p class="text-sm font-bold text-foreground">Your files stay in the browser</p>
            <p class="mt-0.5 text-xs text-muted-foreground">They are read and compared locally.</p>
          </div>
        </li>
        <li class="flex items-start gap-3 sm:px-4 sm:first:pl-0 sm:last:pr-0">
          <Icon name="material-symbols:compare-arrows" class="mt-0.5 size-5 shrink-0 text-primary-text" aria-hidden="true" />
          <div>
            <p class="text-sm font-bold text-foreground">You decide what matches</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Suggestions wait for your review.</p>
          </div>
        </li>
        <li class="flex items-start gap-3 sm:px-4 sm:first:pl-0 sm:last:pr-0">
          <Icon name="material-symbols:sync-alt" class="mt-0.5 size-5 shrink-0 text-primary-text" aria-hidden="true" />
          <div>
            <p class="text-sm font-bold text-foreground">Choose how to update</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Apply supported changes or export a file.</p>
          </div>
        </li>
      </ul>

      <section class="mt-20 scroll-mt-20">
        <SectionHeader align="left" eyebrow="The workflow" title="Review before anything changes" subtitle="Step through loading, matching, resolving differences, and applying or exporting." />
        <SyncVisualizer />
      </section>

      <div class="glass-surface mt-12 relative overflow-hidden rounded-3xl border border-primary/25 bg-gradient-to-br from-primary/10 via-primary/5 to-transparent p-6 shadow-layered sm:flex sm:items-center sm:justify-between sm:gap-8 sm:p-10">
        <div class="max-w-xl">
          <h2 class="text-2xl font-extrabold tracking-tight text-foreground sm:text-3xl">See the review flow with sample data</h2>
          <p class="mt-2 text-sm sm:text-base text-muted-foreground">
            Try matching and conflict resolution with two sample inventories. Nothing leaves your browser.
          </p>
        </div>
        <div class="mt-6 flex shrink-0 flex-wrap justify-center gap-3 sm:mt-0 sm:justify-start">
          <Button
            href="/load?sample=1"
            color="primary"
            size="lg"
            icon="material-symbols:arrow-forward"
            iconPosition="right"
            class="shadow-md shadow-primary/25 hover:shadow-lg hover:shadow-primary/35 hover:-translate-y-0.5 transition-all"
          >
            Explore sample inventories
          </Button>
        </div>
      </div>

      <ServiceMatrix />

      <section class="mt-20 scroll-mt-20" aria-label="For the workshop">
        <SectionHeader
          align="left"
          eyebrow="For the workshop"
          title="Useful tools for everyday printing"
          subtitle="Check filament specs, estimate remaining weight, calculate print cost, and look up drying times."
        />
        <nav
          class="mt-5 flex flex-wrap gap-x-5 gap-y-1 border-t border-border/60 pt-3 text-sm"
          aria-label="Workshop tools"
        >
          <a
            class="inline-flex min-h-11 items-center font-semibold text-primary-text underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            href="#filament-palette-section"
          >
            Filament details
          </a>
          <a
            class="inline-flex min-h-11 items-center font-semibold text-primary-text underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            href="#tare-calculator-section"
          >
            Spool tare
          </a>
          <a
            class="inline-flex min-h-11 items-center font-semibold text-primary-text underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            href="#print-estimator-section"
          >
            Print estimate
          </a>
          <a
            class="inline-flex min-h-11 items-center font-semibold text-primary-text underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            href="#drying-guide-section"
          >
            Drying guide
          </a>
        </nav>
        <FilamentPalette />
        <TareCalculator />
        <PrintEstimator />
        <DryingGuide />
      </section>

      <FaqSection />
    </Container>
  </div>
</BaseLayout>
