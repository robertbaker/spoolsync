---
import Button from "~/components/starwind/controls/Button/Button.astro";
import FlowSteps from "~/components/FlowSteps.astro";
import PageHeader from "~/components/PageHeader.astro";
import SpoolmanConnectionForm from "~/components/connections/SpoolmanConnectionForm.astro";
import TigertagConnectionForm from "~/components/connections/TigertagConnectionForm.astro";
import SpoolmanSetupHelp from "~/components/connections/SpoolmanSetupHelp.astro";
import IconAvatar from "~/components/starwind/controls/IconAvatar/IconAvatar.astro";
import Container from "~/components/starwind/controls/Container/Container.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { SITE_TITLE } from "~/config";

---

<BaseLayout title={`Connections — ${SITE_TITLE}`} description="Connect SpoolSync to your Spoolman server or TigerTag account.">
  <Container class="py-10 sm:py-14">
    <FlowSteps current="connections" class="mb-6" />
    <PageHeader
      eyebrow="Step 1"
      title="Connections"
      description="Your browser connects directly to Spoolman and TigerTag. Addresses and tokens stay in this browser only."
    />

    <div class="mt-10 grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_24rem]">
    <div class="space-y-6">
    <section id="tour-connections" class="app-card" aria-labelledby="spoolman-heading">
      <div class="flex items-center gap-3">
        <IconAvatar icon="vendor/spoolman" color="primary" />
        <h2 id="spoolman-heading" class="text-xl">Spoolman / Spoolman-NG</h2>
        <span id="spoolman-status-badge" class="ml-auto text-xs"></span>
      </div>
      <SpoolmanConnectionForm />
    </section>

    <section class="app-card" aria-labelledby="tigertag-heading">
      <div class="flex items-center gap-3">
        <IconAvatar icon="vendor/tigertag" color="primary" />
        <h2 id="tigertag-heading" class="text-xl">TigerTag cloud <span class="text-sm font-normal text-muted-foreground">(optional)</span></h2>
        <span id="tigertag-status-badge" class="ml-auto text-xs"></span>
      </div>
      <p class="mt-3 text-sm text-muted-foreground">
        Sign in to read and update your TigerTag inventory directly without exporting <code>.ttag</code> files. Your password is sent directly to TigerTag's authentication service and is never stored; SpoolSync only keeps the session token.
      </p>
      <TigertagConnectionForm />
    </section>

    <div class="flex justify-end">
      <Button href="/load" color="primary" icon="material-symbols:arrow-forward" iconPosition="right">Continue to Load</Button>
    </div>
    </div>

    <aside class="space-y-4 lg:sticky lg:top-24" aria-labelledby="help-heading">
      <h2 id="help-heading" class="text-lg">Setting up Spoolman</h2>
      <SpoolmanSetupHelp />
    </aside>
    </div>
  </Container>
</BaseLayout>

<script>
  import "~/scripts/connections";
</script>
