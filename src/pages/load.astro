---
import FlowSteps from "~/components/FlowSteps.astro";
import PageHeader from "~/components/PageHeader.astro";
import { Icon } from "astro-icon/components";
import Button from "~/components/starwind/controls/Button/Button.astro";
import Container from "~/components/starwind/controls/Container/Container.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { SITE_TITLE } from "~/config";
import SourcePanel from "~/components/SourcePanel.astro";
import SourceTile from "~/components/SourceTile.astro";
import SpoolmanConnectionForm from "~/components/connections/SpoolmanConnectionForm.astro";
import SpoolmanSetupHelp from "~/components/connections/SpoolmanSetupHelp.astro";
import TigertagConnectionForm from "~/components/connections/TigertagConnectionForm.astro";
import { SERVICE_COUNT_WORD, SERVICE_VIEWS, acceptAllFiles, extensionList, serviceView } from "~/lib/services";
import { serviceLogoSrc } from "~/lib/service-logos";

// Every panel except Spoolman (which has its own settings block) comes from the services registry.
const fileSources = SERVICE_VIEWS.filter((service) => service.id !== "spoolman").map((service) => ({
  id: service.id,
  label: service.name,
  kind: service.kind,
  icon: service.icon,
  image: serviceLogoSrc(service.id),
  accept: service.accept,
  how: service.how,
  cloud: service.id === "tigertag",
  api: service.id === "bambuddy",
  readonly: !service.canWrite,
  hasApiBadge: service.apiInBrowser,
}));
const dropAccept = acceptAllFiles();
const spoolman = serviceView("spoolman");
---

<BaseLayout
  title={`Load — ${SITE_TITLE}`}
  description={`Step 1 of 3: load spool inventories from any of ${SERVICE_COUNT_WORD} supported tools, then review and apply changes.`}
>
  <div class="relative isolate overflow-hidden">
    <div class="hero-glow-backdrop" aria-hidden="true"></div>

    <Container class="relative z-10 py-10 sm:py-14">
      <FlowSteps current="load" class="mb-6" />
      <PageHeader
        eyebrow="Step 1 of 3"
        title="Load inventories"
        description="Drop your export files or open a service to fetch from it. Nothing is modified yet. Loaded inventories and API keys clear when you close this tab; your Spoolman address, match answers and history stay on this device."
      />

      <section id="tour-drop" class="app-card mt-8 backdrop-blur-xs transition-all hover:border-primary/40 hover:shadow-md" aria-labelledby="smart-heading">
        <h2 id="smart-heading" class="text-xl font-bold">Drop your exports</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          Drop files from any of the {SERVICE_COUNT_WORD} supported services. SpoolSync works out which service each one belongs to; if a file could be
          from several, it asks.
        </p>
        <label id="smart-drop" for="smart-file" class="dropzone group mt-4">
          <span class="flex size-14 items-center justify-center rounded-2xl bg-primary/10 border border-primary/20 text-primary-text mb-1 transition-transform group-hover:scale-105">
            <Icon name="material-symbols:upload-file-outline-rounded" class="size-7" aria-hidden="true" />
          </span>
          <span class="font-semibold text-foreground text-base">Choose export files</span>
          <span class="text-xs text-muted-foreground">or drop several at once ({extensionList()})</span>
          <input id="smart-file" type="file" multiple accept={dropAccept} class="sr-only" />
        </label>
        <div id="smart-message" class="mt-4 empty:mt-0" aria-live="polite"></div>
        <p id="sample-prompt" class="mt-3 text-sm text-muted-foreground">
          No files handy?&nbsp;<button type="button" id="try-sample" class="font-semibold text-primary-text underline underline-offset-2 hover:no-underline">
            Try it with sample data →
          </button>
        </p>
      </section>

    <div id="tour-services" class="mt-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold">Services</h2>
        <p id="source-count" class="text-sm text-muted-foreground" aria-live="polite"></p>
      </div>
      <search class="flex w-full flex-wrap items-center gap-3 sm:w-auto">
        <input
          id="source-search"
          type="search"
          placeholder="Find a service... (/)"
          aria-label="Find a service"
          aria-keyshortcuts="/"
          class="field-input mt-0 w-full py-1.5 text-sm sm:w-56"
        />
        <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter services">
          {
            [
              ["all", "All"],
              ["loaded", "Loaded"],
              ["api", "Live (API)"],
              ["readonly", "Read-only"],
            ].map(([value, label]) => (
              <button
                type="button"
                data-source-filter={value}
                aria-pressed={value === "all"}
                class="min-h-9 rounded-full border px-3.5 py-1 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted aria-pressed:border-primary/50 aria-pressed:bg-primary/15 aria-pressed:text-primary-text"
              >
                {label}
              </button>
            ))
          }
        </div>
      </search>
    </div>

    <div class="mt-3 rounded-lg border bg-muted/20 p-3">
      <label class="flex items-start gap-2 text-sm" for="auto-fetch">
        <input id="auto-fetch" type="checkbox" class="mt-0.5 size-4" aria-describedby="auto-fetch-hint" />
        <span class="font-medium">Fetch connected services when this page opens</span>
      </label>
      <p id="auto-fetch-hint" class="field-hint ml-6">
        Contacts the servers you have connected (including ones on your local network) each time you open Load, using the saved address and key.
      </p>
    </div>

    <section data-tile-section class="mt-4" aria-labelledby="connect-heading">
      <h3 id="connect-heading" class="mb-2 text-sm font-semibold text-muted-foreground">Connect to a server</h3>
      <div class="grid gap-3 sm:grid-cols-2 2xl:grid-cols-4" role="group" aria-labelledby="connect-heading">
        <SourceTile id="spoolman" label={spoolman.name} kind={spoolman.kind} icon={spoolman.icon} api />
        {
          fileSources
            .filter((source) => source.hasApiBadge)
            .map((source) => (
              <SourceTile id={source.id} label={source.label} kind={source.kind} icon={source.icon} image={source.image} api />
            ))
        }
      </div>
    </section>
    <section data-tile-section class="mt-5" aria-labelledby="files-heading">
      <h3 id="files-heading" class="mb-2 text-sm font-semibold text-muted-foreground">
        From an export file
      </h3>
      <p class="-mt-1 mb-2 text-xs text-muted-foreground">Drop any of these above, or pick one to see its export steps.</p>
      <div class="flex flex-wrap gap-2" role="group" aria-labelledby="files-heading">
        {
          fileSources
            .filter((source) => !source.hasApiBadge)
            .map((source) => (
              <SourceTile
                id={source.id}
                label={source.label}
                kind={source.kind}
                icon={source.icon}
                image={source.image}
                readonly={source.readonly}
                compact
              />
            ))
        }
      </div>
    </section>
    <p id="source-empty" class="mt-4 rounded-lg border border-dashed p-6 text-center text-muted-foreground" hidden>
      No service matches. Clear the search or choose another filter.
    </p>

    <div id="source-stage" class="mt-4 [&>details:not([open])]:hidden [&:has(>details[open])>#source-hint]:hidden">
      <p id="source-hint" class="rounded-xl border border-dashed p-5 text-center text-sm text-muted-foreground">
        Choose a service above to connect to it or load its export file.
      </p>
      <SourcePanel id="spoolman" tourId="tour-load" label={spoolman.name} kind={spoolman.kind} icon={spoolman.icon} api open>
        <p id="spoolman-target" class="mb-3 break-all text-sm text-muted-foreground empty:hidden"></p>
        <div class="flex flex-wrap gap-3">
          <Button type="button" color="primary" id="spoolman-load">Fetch spools</Button>
          <Button type="button" variant="outline" data-open-settings="spoolman">Connection settings</Button>
        </div>
        <details id="spoolman-settings" class="mt-4 rounded-xl border bg-muted/20">
          <summary class="cursor-pointer rounded-xl p-3 text-sm font-medium focus-visible:outline-2 focus-visible:outline-primary">
            Connection settings
          </summary>
          <div class="p-4 pt-1">
            <SpoolmanConnectionForm badge />
            <details class="mt-5 rounded-lg border">
              <summary class="cursor-pointer p-3 text-sm font-medium">Setup help: CORS and plain http://</summary>
              <div class="p-3 pt-0"><SpoolmanSetupHelp /></div>
            </details>
          </div>
        </details>
        <p class="mt-4 text-sm text-muted-foreground">
          Or load a file instead: a Spoolman export (Settings → Export, JSON or CSV), the API export from&nbsp;<code>/api/v1/export/spools?fmt=json</code>, or a raw JSON list of spools from the API.
        </p>
        <label id="spoolman-drop" for="spoolman-file" class="dropzone mt-3">
          <Icon name="material-symbols:upload-file-outline-rounded" class="size-7 text-primary" aria-hidden="true" />
          <span class="font-medium text-foreground">Choose a JSON or CSV file</span>
          <span>or drop it here</span>
          <input id="spoolman-file" type="file" accept={spoolman.accept} class="sr-only" />
        </label>
      </SourcePanel>

      {
        fileSources.map((source) => (
          <SourcePanel
            id={source.id}
            label={source.label}
            kind={source.kind}
            icon={source.icon}
            image={source.image}
            api={source.hasApiBadge}
            readonly={source.readonly}
          >
            {source.cloud && (
              <div class="mb-3 flex flex-wrap items-center gap-3">
                <Button type="button" color="primary" id={`${source.id}-cloud`}>Fetch from TigerTag cloud</Button>
                <span id={`${source.id}-cloud-hint`} class="text-sm text-muted-foreground" />
              </div>
            )}
            {source.cloud && (
              <details id="tigertag-settings" class="mb-3 rounded-xl border bg-muted/20">
                <summary class="cursor-pointer rounded-xl p-3 text-sm font-medium focus-visible:outline-2 focus-visible:outline-primary">
                  Account sign-in
                </summary>
                <div class="p-4 pt-1">
                  <p class="mb-4 text-sm text-muted-foreground">
                    Your password goes straight to TigerTag's sign-in service and is never stored; SpoolSync keeps only the session token, for this tab only unless you choose to remember it.
                  </p>
                  <TigertagConnectionForm badge />
                </div>
              </details>
            )}
            {source.api && (
              <div class="mb-3">
                <div class="grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
                  <div>
                    <label class="field-label" for="bambuddy-url">Bambuddy server address</label>
                    <input id="bambuddy-url" type="url" placeholder="http://bambuddy.local:8000" autocomplete="off" spellcheck="false" class="field-input mt-1" />
                  </div>
                  <div>
                    <label class="field-label" for="bambuddy-key">Bambuddy API key</label>
                    <input id="bambuddy-key" type="password" placeholder="API key" autocomplete="off" spellcheck="false" class="field-input mt-1" />
                  </div>
                  <div class="flex gap-2">
                    <Button type="button" color="primary" id="bambuddy-fetch" aria-describedby="bambuddy-hint">Fetch spools</Button>
                    <Button type="button" variant="outline" id="bambuddy-forget">Forget</Button>
                  </div>
                </div>
                <p id="bambuddy-hint" class="field-hint">
                  Needs an API key with the Read status scope. Enter the address and key to enable fetching. Kept for this tab only and cleared when it closes.
                </p>
              </div>
            )}
            {source.id === "filamentdb" && (
              <div class="mb-3">
                <div class="grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
                  <div>
                    <label class="field-label" for="filamentdb-url">FilamentDB server address</label>
                    <input id="filamentdb-url" type="url" placeholder="http://filamentdb.local:3000" autocomplete="off" spellcheck="false" class="field-input mt-1" />
                  </div>
                  <div>
                    <label class="field-label" for="filamentdb-token">FilamentDB session token</label>
                    <input id="filamentdb-token" type="password" placeholder="Only with user management" autocomplete="off" spellcheck="false" class="field-input mt-1" />
                  </div>
                  <div class="flex gap-2">
                    <Button type="button" color="primary" id="filamentdb-fetch" aria-describedby="filamentdb-hint">Fetch spools</Button>
                    <Button type="button" variant="outline" id="filamentdb-forget">Forget</Button>
                  </div>
                </div>
                <p id="filamentdb-hint" class="field-hint">
                  Enter the server address to enable fetching. The token is only needed when user management is on. Kept for this tab only and cleared when it closes.
                </p>
              </div>
            )}
            <p class="mb-4 text-sm text-muted-foreground">{source.cloud ? `Or use a file: ${source.how}` : source.how}</p>
            {(source.id === "tigertag" || source.id === "spoolio") && (
              <Button type="button" variant="outline" class="mb-3" id={`${source.id}-empty`}>Start empty {source.label} inventory</Button>
            )}
            <label id={`${source.id}-drop`} for={`${source.id}-file`} class="dropzone">
              <Icon name="material-symbols:upload-file-outline-rounded" class="size-7 text-primary" aria-hidden="true" />
              <span class="font-medium text-foreground">Choose a {source.kind} file</span>
              <span>or drop it here</span>
              <input id={`${source.id}-file`} type="file" accept={source.accept} class="sr-only" />
            </label>
          </SourcePanel>
        ))
      }
    </div>

    <section class="app-card mt-10" aria-labelledby="loaded-heading">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b pb-4">
        <div>
          <h2 id="loaded-heading" class="text-xl font-bold">Loaded spools</h2>
          <p id="loaded-summary" class="mt-1 text-sm text-muted-foreground" aria-live="polite"></p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <label id="low-threshold-wrap" hidden class="flex items-center gap-2 text-xs text-muted-foreground">
            <span>Low at</span>
            <select id="low-threshold" class="field-input mt-0 w-auto py-1 text-xs">
              <option value="10">10%</option>
              <option value="15">15%</option>
              <option value="20">20%</option>
              <option value="25">25%</option>
              <option value="30">30%</option>
              <option value="40">40%</option>
              <option value="50">50%</option>
            </select>
          </label>
          <button
            type="button"
            id="low-only"
            hidden
            aria-pressed="false"
            class="rounded-md border px-3 py-1.5 text-xs font-medium text-warning-text transition-colors hover:bg-warning/10 aria-pressed:border-warning/50 aria-pressed:bg-warning/15"
          >
            Running low
          </button>
          <Button type="button" variant="outline" color="neutral" size="sm" id="copy-reorder" hidden>Copy reorder list</Button>
          <Button type="button" variant="outline" color="neutral" size="sm" id="print-labels" hidden>Print labels</Button>
          <Button type="button" variant="outline" color="neutral" size="sm" id="download-combined" hidden>Download all as CSV</Button>
          <Button type="button" variant="outline" color="error" size="sm" class="sm:ml-auto" id="unload-all" hidden>Unload all</Button>
        <div id="loaded-filter-wrap" class="w-full sm:w-auto" hidden>
          <input
            id="spool-search-input"
            type="search"
            placeholder="Filter loaded spools..."
            class="field-input mt-0 py-1.5 text-xs w-full sm:w-64"
            aria-label="Filter loaded spools"
          />
        </div>
        </div>
      </div>
      <div id="loaded-stats" class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" hidden></div>
      <section id="health-dashboard" class="mt-5 rounded-xl border p-4" aria-labelledby="health-dashboard-heading" hidden></section>
      <div id="loaded-chart" class="mt-5 rounded-xl border p-4" hidden></div>
      <div id="loaded-insights" class="mt-5 grid gap-4 lg:grid-cols-2" hidden>
        <section id="insight-health" class="rounded-xl border p-4" aria-labelledby="insight-health-heading"></section>
        <section id="insight-duplicates" class="rounded-xl border p-4" aria-labelledby="insight-duplicates-heading"></section>
        <section id="insight-changes" class="rounded-xl border p-4" aria-labelledby="insight-changes-heading" aria-live="polite"></section>
        <section id="insight-watchlist" class="rounded-xl border p-4" aria-labelledby="insight-watchlist-heading"></section>
      </div>
      <div id="insight-chips" class="mt-4 flex flex-wrap items-center gap-2" role="group" aria-label="Filter spools by check" hidden></div>
      <div id="loaded-trend" class="mt-5 rounded-xl border p-4" hidden></div>
      <div id="loaded-cost" class="mt-5 rounded-xl border p-4" hidden></div>
      <div id="reorder-panel" class="mt-5" hidden></div>
      <div id="drying-panel" class="mt-5" hidden></div>
      <div id="cleanup-panel" class="mt-5" hidden></div>
      <div id="reference-panel" class="mt-5" hidden></div>
      <div id="saved-views" class="mt-5" hidden></div>
      <div id="table-tools" class="table-tools" hidden></div>
      <div id="loaded-table" class="mt-4"></div>
    </section>

    <div
      id="load-bar"
      hidden
      class="sticky bottom-[var(--bar-bottom)] z-10 md:pr-[var(--bar-end-pad)] mt-6 flex flex-wrap items-center justify-between gap-x-3 gap-y-2 sm:flex-nowrap rounded-2xl border bg-card/95 p-2.5 pl-4 sm:p-3 sm:pl-5 shadow-lg backdrop-blur supports-[backdrop-filter]:bg-card/80"
    >
      <p id="load-bar-summary" class="min-w-0 flex-1 text-xs text-muted-foreground sm:text-sm" aria-live="polite">
        Nothing loaded yet. Drop export files above or open a service below.
      </p>
      <Button href="/sync" color="primary" id="continue-sync" size="sm" class="shrink-0" aria-disabled="true" aria-describedby="load-bar-summary" icon="material-symbols:arrow-forward" iconPosition="right">
        Continue to review
      </Button>
    </div>
  </Container>
  </div>
</BaseLayout>

<script>
  import "~/scripts/load";
</script>
