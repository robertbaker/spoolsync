# Dependencies
node_modules/

# Build output (dist/ is the Astro site Wrangler serves; packages build their own dist/)
dist/
.astro/
.wrangler/
.turbo/

# Test reports, traces, and other local tool output (Playwright writes here)
.artifacts/
.lighthouseci/
.tmp-lhci/
.playwright-mcp/
*.log

# Reference-data snapshots, generated by `bun run snapshot:reference` at build time
public/reference/

# Personal reference exports (never commit)
ref/
.ref/

# Local environment and editor state
.env*
.DS_Store
.claude/worktrees/
