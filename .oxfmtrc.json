{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": true,
  "sortTailwindcss": true,
  "jsdoc": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.*/**",
    "**/.*",
    "**/dist/**",
    "**/build/**",
    "**/wrangler.jsonc",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/worker-configuration.d.ts"
  ]
}
