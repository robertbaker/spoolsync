{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2025": true
  },
  "plugins": ["unicorn", "typescript", "oxc", "import", "jsdoc", "vitest", "promise", "node"],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "eqeqeq": "warn",
    "no-var": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.*/**",
    "**/.*",
    "**/dist/**",
    "**/build/**",
    "**/*.min.js"
  ]
}
