{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "paths": {
      "@spoolsync/core": ["./packages/spoolsync-core/src/index.ts"],
      "@spoolsync/core/*": ["./packages/spoolsync-core/src/*"],
      "~/*": ["./src/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@/types": ["./src/types/index.ts"],
      "@/types/*": ["./src/types/*"],
      "@/components/*": ["./src/components/*"],
      "@/features/*": ["./src/features/*"]
    },
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noPropertyAccessFromIndexSignature": false,
    "types": ["bun-types", "@types/node"],
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": [".astro/types.d.ts", "src", "tests", "e2e", "packages/*/src"],
  "exclude": [
    "dist",
    "node_modules",
    "src/components/starwind/blocks/site/Footer/FooterNav.astro",
    "src/components/starwind/blocks/site/Footer/SocialLinks.astro",
    "src/components/starwind/blocks/site/SiteHeader/DesktopMegaNav.astro",
    "src/components/starwind/blocks/site/SiteHeader/HeaderLogo.astro",
    "src/components/starwind/controls/SEO/SEO.astro",
    "src/components/starwind/layouts/SiteBaseLayout.astro"
  ]
}
